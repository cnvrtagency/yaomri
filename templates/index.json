            "html_content": "<a href=\"/collections/the-sunset-mirage-collection\" class=\"video-link\">\n  <div class=\"custom-video-wrap\">\n    <video class=\"custom-video\" playsinline=\"\" muted=\"\" autoplay=\"\" loop=\"\" preload=\"metadata\">\n      <source src=\"https://cdn.shopify.com/videos/c/o/v/864cb633fdb445e182e27a3e9fe4a9c8.mp4\" type=\"video/mp4\">\n      Your browser does not support the video tag.\n    </source></video>\n\n    <h3 class=\"video-title\">SUNSET MIRAGE</h3>\n  </div>\n</a>\n\n<style>\n  .video-link {\n    display: block;\n    text-decoration: none;\n    color: inherit;\n  }\n\n  .custom-video-wrap {\n    position: relative;\n    width: 100%;\n    line-height: 0;\n    overflow: hidden;\n  }\n\n  .custom-video {\n    display: block;\n    width: 100%;\n    height: auto;\n    object-fit: cover;\n    background: #000;\n    pointer-events: none;\n  }\n\n  .video-title {\n    position: absolute;\n    bottom: 20px;\n    left: 20px;\n    margin: 0;\n    font-family: 'Montserrat', sans-serif;\n    text-transform: uppercase;\n    letter-spacing: 4px;\n    font-weight: 400;\n    font-size: 18px;\n    color: #fff;\n    line-height: 1;\n    pointer-events: none;\n  }\n\n  /* MOBILE */\n  @media (max-width: 767px) {\n    .video-title {\n      font-size: 15px;\n      bottom: 15px;\n      left: 15px;\n    }\n  }\n</style>",
