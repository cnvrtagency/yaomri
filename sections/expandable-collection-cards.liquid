{{ 'section-expandable-collection-cards.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-expandable-collection-cards.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign st = section.settings
  assign active_index = st.default_active_card
  for block in section.blocks
    if block.settings.set_as_default_active
      assign active_index = forloop.index
      break
    endif
  endfor
-%}

<section
  id="ExpandableCollections-{{ section.id }}"
  class="expandable-collections expandable-collections--width-{{ st.section_width }} expandable-collections--heading-{{ st.heading_alignment }} expandable-collections--content-{{ st.content_position }} expandable-collections--collapsed-{{ st.collapsed_content_position }}"
  data-expandable-collections
  data-section-id="{{ section.id }}"
  data-desktop-behaviour="{{ st.desktop_behaviour }}"
  data-default-active="{{ active_index }}"
  data-mobile-default-open="{{ st.mobile_default_open_card }}"
  data-allow-multiple="{{ st.allow_multiple_open }}"
  data-auto-rotate="{{ st.auto_rotate }}"
  data-auto-rotate-delay="{{ st.auto_rotate_delay | times: 1000 }}"
  data-pause-on-hover="{{ st.pause_auto_rotate_on_hover }}"
  style="
    --ecc-section-bg: {{ st.section_background }};
    --ecc-container-max-width: {{ st.container_max_width }}px;
    --ecc-heading-max-width: {{ st.heading_max_width }}px;
    --ecc-padding-desktop: {{ st.padding_desktop }}px;
    --ecc-padding-mobile: {{ st.padding_mobile }}px;
    --ecc-header-gap: {{ st.heading_spacing_bottom }}px;
    --ecc-section-eyebrow-color: {{ st.eyebrow_text_color }};
    --ecc-section-eyebrow-bg: {{ st.eyebrow_background_color }};
    --ecc-heading-color: {{ st.heading_text_color }};
    --ecc-subheading-color: {{ st.subheading_text_color }};
    --ecc-overlay-color: {{ st.overlay_color }};
    --ecc-overlay-opacity: {{ st.inactive_overlay_opacity | divided_by: 100.0 }};
    --ecc-overlay-active-opacity: {{ st.active_overlay_opacity | divided_by: 100.0 }};
    --ecc-card-height: {{ st.card_height_desktop }}px;
    --ecc-card-closed-height-mobile: {{ st.card_closed_height_mobile }}px;
    --ecc-card-expanded-height-mobile: {{ st.card_expanded_height_mobile }}px;
    --ecc-active-card-width: {{ st.active_card_width_desktop }}px;
    --ecc-inactive-card-width: {{ st.inactive_card_width_desktop }}px;
    --ecc-gap-desktop: {{ st.card_gap_desktop }}px;
    --ecc-gap-mobile: {{ st.card_gap_mobile }}px;
    --ecc-card-radius: {{ st.card_radius }}px;
    --ecc-card-shadow: {% if st.card_shadow %}0 24px 60px rgba(0, 0, 0, 0.18){% else %}none{% endif %};
    --ecc-border-color: {{ st.border_color }};
    --ecc-border-width: {{ st.border_width }}px;
    --ecc-content-padding-desktop: {{ st.card_content_padding_desktop }}px;
    --ecc-content-padding-mobile: {{ st.card_content_padding_mobile }}px;
    --ecc-transition-speed: {{ st.transition_speed }}ms;
    --ecc-card-eyebrow-color: {{ st.card_eyebrow_text_color }};
    --ecc-card-eyebrow-bg: {{ st.card_eyebrow_background_color }};
    --ecc-card-title-color: {{ st.card_title_color }};
    --ecc-card-description-color: {{ st.card_description_color }};
    --ecc-card-button-text: {{ st.card_button_text_color }};
    --ecc-card-button-bg: {{ st.card_button_background_color }};
    --ecc-card-button-border: {{ st.card_button_border_color }};
    --ecc-card-button-hover-text: {{ st.card_button_hover_text_color }};
    --ecc-card-button-hover-bg: {{ st.card_button_hover_background_color }};
    --ecc-card-button-hover-border: {{ st.card_button_hover_border_color }};
    --ecc-card-arrow-color: {{ st.card_arrow_color }};
  "
>
  <div class="expandable-collections__inner">
    {%- if st.eyebrow != blank or st.heading != blank or st.subheading != blank -%}
      <div class="expandable-collections__header">
        {%- if st.eyebrow != blank -%}
          <p class="expandable-collections__eyebrow">{{ st.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if st.heading != blank -%}
          <h2 class="expandable-collections__heading">{{ st.heading | escape }}</h2>
        {%- endif -%}
        {%- if st.subheading != blank -%}
          <div class="expandable-collections__subheading">{{ st.subheading }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="expandable-collections__cards" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign bst = block.settings
          assign card_collection = bst.collection
          assign card_url = bst.button_link
          if card_url == blank and card_collection != blank
            assign card_url = card_collection.url
          endif

          assign card_title = bst.title
          if card_title == blank and card_collection != blank
            assign card_title = card_collection.title
          endif
          if card_title == blank
            assign card_title = 'Collection'
          endif

          assign card_image = bst.image
          if card_image == blank and card_collection != blank
            assign card_image = card_collection.featured_image
          endif
          assign mobile_image = bst.mobile_image
          if mobile_image == blank
            assign mobile_image = card_image
          endif

          assign card_description = bst.description
          if card_description == blank and card_collection != blank
            assign card_description = card_collection.description
          endif

          assign is_active = false
          if forloop.index == active_index
            assign is_active = true
          endif
        -%}

        <article
          class="expandable-collections__card{% if is_active %} is-active{% endif %}"
          role="listitem"
          data-expandable-card
          data-card-index="{{ forloop.index }}"
          data-block-id="{{ block.id }}"
          style="--ecc-image-position: {{ bst.image_position }};"
          {{ block.shopify_attributes }}
        >
          <div class="expandable-collections__media">
            {%- if card_image != blank -%}
              <picture>
                {%- if mobile_image != blank -%}
                  <source media="(max-width: 767px)" srcset="{{ mobile_image | image_url: width: 900 }}">
                {%- endif -%}
                {{ card_image | image_url: width: 1600 | image_tag: loading: 'lazy', class: 'expandable-collections__image', alt: card_title }}
              </picture>
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'expandable-collections__placeholder' }}
            {%- endif -%}
          </div>

          <button
            class="expandable-collections__toggle"
            type="button"
            aria-expanded="{% if is_active %}true{% else %}false{% endif %}"
            aria-controls="ExpandableCollectionsPanel-{{ section.id }}-{{ block.id }}"
            data-expandable-toggle
          >
            <span class="expandable-collections__collapsed-copy">
              {%- if bst.badge != blank -%}
                <span class="expandable-collections__badge">{{ bst.badge | escape }}</span>
              {%- endif -%}
              <span class="expandable-collections__collapsed-title">{{ card_title | escape }}</span>
              {%- if st.show_collapsed_description and card_description != blank -%}
                <span class="expandable-collections__collapsed-description">{{ card_description | strip_html | truncate: 90 }}</span>
              {%- endif -%}
            </span>
            {%- if st.show_collapsed_arrow -%}
              <span class="expandable-collections__arrow" aria-hidden="true"></span>
            {%- endif -%}
          </button>

          <div
            id="ExpandableCollectionsPanel-{{ section.id }}-{{ block.id }}"
            class="expandable-collections__panel"
            data-expandable-panel
          >
            <div class="expandable-collections__content">
              {%- if bst.icon != blank -%}
                {{ bst.icon | image_url: width: 96 | image_tag: loading: 'lazy', class: 'expandable-collections__icon', alt: '' }}
              {%- endif -%}
              {%- if bst.badge != blank -%}
                <p class="expandable-collections__card-eyebrow">{{ bst.badge | escape }}</p>
              {%- endif -%}
              <h3 class="expandable-collections__title">{{ card_title | escape }}</h3>
              {%- if card_description != blank -%}
                <div class="expandable-collections__description">{{ card_description }}</div>
              {%- endif -%}
              {%- if bst.button_label != blank and card_url != blank -%}
                <a
                  class="expandable-collections__button"
                  href="{{ card_url }}"
                  {% if bst.open_in_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                >
                  {{ bst.button_label | escape }}
                </a>
              {%- endif -%}
            </div>
          </div>

          {%- if st.show_mobile_closed_cta and bst.button_label != blank and card_url != blank -%}
            <a
              class="expandable-collections__mobile-closed-link"
              href="{{ card_url }}"
              {% if bst.open_in_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
            >
              {{ bst.button_label | escape }}
            </a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

