{{ 'section-expandable-collection-cards.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-expandable-collection-cards.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign st = section.settings
  assign card_title_font = st.card_title_font_family
  assign card_cta_font = st.card_cta_font_family
-%}

{%- style -%}
  {{ card_title_font | font_face: font_display: 'swap' }}
  {{ card_cta_font | font_face: font_display: 'swap' }}

  #shopify-section-{{ section.id }} {
    --ecc-card-title-font-family: {{ card_title_font.family }}, {{ card_title_font.fallback_families }};
    --ecc-card-cta-font-family: {{ card_cta_font.family }}, {{ card_cta_font.fallback_families }};
  }
{%- endstyle -%}

<section
  id="ExpandableCollections-{{ section.id }}"
  class="expandable-collections expandable-collections--width-{{ st.section_width }} expandable-collections--heading-desktop-{{ st.heading_alignment_desktop }} expandable-collections--heading-mobile-{{ st.heading_alignment_mobile }} expandable-collections--content-{{ st.content_position }}"
  data-expandable-collections
  data-section-id="{{ section.id }}"
  data-desktop-behaviour="{{ st.desktop_behaviour }}"
  data-default-active="{{ st.default_active_card }}"
  data-mobile-default-open="{{ st.mobile_default_open_card }}"
  data-allow-multiple="{{ st.allow_multiple_open }}"
  data-auto-rotate="{{ st.auto_rotate }}"
  data-auto-rotate-delay="{{ st.auto_rotate_delay | times: 1000 }}"
  data-pause-on-hover="{{ st.pause_auto_rotate_on_hover }}"
  data-transition-speed="{{ st.transition_speed }}"
  data-hover-overlay="{{ st.enable_hover_overlay }}"
  style="
    --ecc-section-bg: {{ st.section_background }};
    --ecc-container-max-width: {{ st.container_max_width }}px;
    --ecc-heading-max-width: {{ st.heading_max_width }}px;
    --ecc-padding-top-desktop: {{ st.padding_top_desktop }}px;
    --ecc-padding-bottom-desktop: {{ st.padding_bottom_desktop }}px;
    --ecc-padding-left-desktop: {{ st.padding_left_desktop }}px;
    --ecc-padding-right-desktop: {{ st.padding_right_desktop }}px;
    --ecc-padding-top-mobile: {{ st.padding_top_mobile }}px;
    --ecc-padding-bottom-mobile: {{ st.padding_bottom_mobile }}px;
    --ecc-padding-left-mobile: {{ st.padding_left_mobile }}px;
    --ecc-padding-right-mobile: {{ st.padding_right_mobile }}px;
    --ecc-heading-gap: {{ st.heading_spacing_bottom }}px;
    --ecc-section-eyebrow-color: {{ st.eyebrow_text_color }};
    --ecc-heading-color: {{ st.heading_text_color }};
    --ecc-subheading-color: {{ st.subheading_text_color }};
    --ecc-eyebrow-size-desktop: {{ st.eyebrow_font_size_desktop }}px;
    --ecc-eyebrow-size-mobile: {{ st.eyebrow_font_size_mobile }}px;
    --ecc-eyebrow-weight: {{ st.eyebrow_font_weight }};
    --ecc-eyebrow-letter-spacing: {{ st.eyebrow_letter_spacing }}px;
    --ecc-eyebrow-text-transform: {{ st.eyebrow_text_transform }};
    --ecc-heading-size-desktop: {{ st.heading_font_size_desktop }}px;
    --ecc-heading-size-mobile: {{ st.heading_font_size_mobile }}px;
    --ecc-subheading-size: {{ st.subheading_font_size }}px;
    --ecc-overlay-color: {{ st.overlay_color | default: '#111111' }};
    --ecc-overlay-opacity-inactive: {{ st.inactive_overlay_opacity | divided_by: 100.0 }};
    --ecc-overlay-opacity-active: {{ st.active_overlay_opacity | divided_by: 100.0 }};
    --ecc-hover-overlay-color: {{ st.hover_overlay_color | default: '#000000' }};
    --ecc-hover-overlay-opacity: {% if st.enable_hover_overlay %}{{ st.hover_overlay_opacity | divided_by: 100.0 }}{% else %}0{% endif %};
    --ecc-card-height: {{ st.card_height_desktop }}px;
    --ecc-card-closed-height-mobile: {{ st.card_closed_height_mobile }}px;
    --ecc-card-expanded-height-mobile: {{ st.card_expanded_height_mobile }}px;
    --ecc-active-card-width: {{ st.active_card_width_desktop }}px;
    --ecc-inactive-card-width: {{ st.inactive_card_width_desktop }}px;
    --ecc-gap-desktop: {{ st.card_gap_desktop }}px;
    --ecc-gap-mobile: {{ st.card_gap_mobile }}px;
    --ecc-card-radius: {{ st.card_radius }}px;
    --ecc-card-shadow: {% if st.card_shadow %}0 24px 60px rgba(0, 0, 0, 0.18){% else %}none{% endif %};
    --ecc-border-color: {{ st.border_color }};
    --ecc-border-width: {{ st.border_width }}px;
    --ecc-content-padding-desktop: {{ st.card_content_padding_desktop }}px;
    --ecc-content-padding-mobile: {{ st.card_content_padding_mobile }}px;
    --ecc-card-title-cta-gap-desktop: {{ st.card_title_cta_gap_desktop }}px;
    --ecc-card-title-cta-gap-mobile: {{ st.card_title_cta_gap_mobile }}px;
    --ecc-transition-speed: {{ st.transition_speed }}ms;
    --ecc-card-eyebrow-color: {{ st.card_eyebrow_text_color }};
    --ecc-card-title-color: {{ st.card_title_color }};
    --ecc-card-eyebrow-size-desktop: {{ st.card_eyebrow_font_size_desktop }}px;
    --ecc-card-eyebrow-size-mobile: {{ st.card_eyebrow_font_size_mobile }}px;
    --ecc-card-eyebrow-weight: {{ st.card_eyebrow_font_weight }};
    --ecc-card-eyebrow-letter-spacing: {{ st.card_eyebrow_letter_spacing }}px;
    --ecc-card-eyebrow-text-transform: {{ st.card_eyebrow_text_transform }};
    --ecc-card-title-size-desktop: {{ st.card_title_font_size_desktop }}px;
    --ecc-card-title-size-mobile: {{ st.card_title_font_size_mobile }}px;
    --ecc-card-title-weight: {{ st.card_title_font_weight }};
    --ecc-card-title-font-style: {{ st.card_title_font_style }};
    --ecc-card-title-line-height: {{ st.card_title_line_height }};
    --ecc-card-title-letter-spacing: {{ st.card_title_letter_spacing }}px;
    --ecc-card-title-text-transform: {{ st.card_title_text_transform }};
    --ecc-card-title-width-desktop: {{ st.card_title_width_desktop }}%;
    --ecc-card-title-width-mobile: {{ st.card_title_width_mobile }}%;
    --ecc-card-cta-size-desktop: {{ st.card_cta_font_size_desktop }}px;
    --ecc-card-cta-size-mobile: {{ st.card_cta_font_size_mobile }}px;
    --ecc-card-cta-weight: {{ st.card_cta_font_weight }};
    --ecc-card-cta-line-height: {{ st.card_cta_line_height }};
    --ecc-card-cta-letter-spacing: {{ st.card_cta_letter_spacing }}px;
    --ecc-card-cta-text-transform: {{ st.card_cta_text_transform }};
    --ecc-card-button-text: {{ st.card_button_text_color }};
    --ecc-card-button-bg: {{ st.card_button_background_color }};
    --ecc-card-button-border: {{ st.card_button_border_color }};
    --ecc-card-button-radius: {{ st.card_button_radius }}px;
    --ecc-card-button-hover-text: {{ st.card_button_hover_text_color }};
    --ecc-card-button-hover-bg: {{ st.card_button_hover_background_color }};
    --ecc-card-button-hover-border: {{ st.card_button_hover_border_color }};
  "
>
  <div class="expandable-collections__inner">
    {%- if st.eyebrow != blank or st.heading != blank or st.subheading != blank -%}
      <div class="expandable-collections__header">
        {%- if st.eyebrow != blank -%}
          <p class="expandable-collections__eyebrow">{{ st.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if st.heading != blank -%}
          <h2 class="expandable-collections__heading">{{ st.heading | escape }}</h2>
        {%- endif -%}
        {%- if st.subheading != blank -%}
          <div class="expandable-collections__subheading">{{ st.subheading }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="expandable-collections__cards" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign bst = block.settings
          assign card_collection = bst.collection
          assign card_url = bst.button_link
          if card_url == blank and card_collection != blank
            assign card_url = card_collection.url
          endif
          if card_url == blank
            assign card_url = '#'
          endif

          assign card_title = bst.title
          if card_title == blank and card_collection != blank
            assign card_title = card_collection.title
          endif
          if card_title == blank
            assign card_title = 'Collection'
          endif

          assign card_image = bst.image
          if card_image == blank and card_collection != blank
            assign card_image = card_collection.featured_image
          endif
          assign mobile_image = bst.mobile_image
          if mobile_image == blank
            assign mobile_image = card_image
          endif
        -%}

        <article
          class="expandable-collections__card{% if forloop.index == st.default_active_card %} is-active{% endif %}"
          role="listitem"
          data-expandable-card
          data-card-index="{{ forloop.index }}"
          data-block-id="{{ block.id }}"
          style="--ecc-image-position: {{ bst.image_position }};"
          {{ block.shopify_attributes }}
        >
          <div class="expandable-collections__media" aria-hidden="true">
            {%- if card_image != blank -%}
              <picture>
                {%- if mobile_image != blank -%}
                  <source media="(max-width: 767px)" srcset="{{ mobile_image | image_url: width: 900 }}">
                {%- endif -%}
                {{ card_image | image_url: width: 1600 | image_tag: loading: 'lazy', class: 'expandable-collections__image', alt: card_title }}
              </picture>
            {%- else -%}
              <div class="expandable-collections__placeholder" aria-hidden="true"></div>
            {%- endif -%}
          </div>

          <button
            class="expandable-collections__trigger"
            type="button"
            aria-label="{{ card_title | escape }}"
            aria-expanded="{% if forloop.index == st.default_active_card %}true{% else %}false{% endif %}"
            aria-controls="ExpandableCollectionsPanel-{{ section.id }}-{{ block.id }}"
            data-expandable-toggle
          ></button>

          <div
            id="ExpandableCollectionsPanel-{{ section.id }}-{{ block.id }}"
            class="expandable-collections__panel"
            data-expandable-panel
          >
            <div class="expandable-collections__content">
              {%- if bst.badge != blank -%}
                <p class="expandable-collections__card-eyebrow">{{ bst.badge | escape }}</p>
              {%- endif -%}
              <h3 class="expandable-collections__title">{{ card_title | escape }}</h3>
              {%- if bst.button_label != blank -%}
                <a class="expandable-collections__button" href="{{ card_url }}">
                  {{ bst.button_label | escape }}
                </a>
              {%- endif -%}
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

