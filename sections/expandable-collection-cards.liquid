{{ 'section-expandable-collection-cards.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-expandable-collection-cards.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign settings = section.settings
  assign active_index = settings.default_active_card
  for block in section.blocks
    if block.settings.set_as_default_active
      assign active_index = forloop.index
      break
    endif
  endfor
-%}

<section
  id="ExpandableCollections-{{ section.id }}"
  class="expandable-collections expandable-collections--align-{{ settings.heading_alignment }} expandable-collections--content-{{ settings.content_position }} expandable-collections--collapsed-{{ settings.collapsed_content_position }}{% if settings.full_width == false %} expandable-collections--contained{% endif %}"
  data-expandable-collections
  data-section-id="{{ section.id }}"
  data-desktop-behaviour="{{ settings.desktop_behaviour }}"
  data-default-active="{{ active_index }}"
  data-auto-rotate="{{ settings.auto_rotate }}"
  data-auto-rotate-delay="{{ settings.auto_rotate_delay | times: 1000 }}"
  data-pause-on-hover="{{ settings.pause_auto_rotate_on_hover }}"
  data-mobile-default-open="{{ settings.mobile_default_open_card }}"
  data-allow-multiple="{{ settings.allow_multiple_open }}"
  style="
    --expandable-collections-bg: {{ settings.section_background }};
    --expandable-collections-text: {{ settings.text_color }};
    --expandable-collections-accent: {{ settings.accent_color }};
    --expandable-collections-overlay: {{ settings.overlay_color }};
    --expandable-collections-overlay-opacity: {{ settings.overlay_opacity | divided_by: 100.0 }};
    --expandable-collections-padding-desktop: {{ settings.padding_desktop }}px;
    --expandable-collections-padding-mobile: {{ settings.padding_mobile }}px;
    --expandable-collections-card-height: {{ settings.card_height_desktop }}px;
    --expandable-collections-mobile-closed-height: {{ settings.card_closed_height_mobile }}px;
    --expandable-collections-mobile-expanded-height: {{ settings.card_expanded_height_mobile }}px;
    --expandable-collections-active-width: {{ settings.active_card_width_desktop }}fr;
    --expandable-collections-inactive-width: {{ settings.inactive_card_width_desktop }}fr;
    --expandable-collections-gap-desktop: {{ settings.card_gap_desktop }}px;
    --expandable-collections-gap-mobile: {{ settings.card_gap_mobile }}px;
    --expandable-collections-radius: {{ settings.card_radius }}px;
    --expandable-collections-shadow: {% if settings.card_shadow %}0 24px 60px rgba(0, 0, 0, 0.18){% else %}none{% endif %};
    --expandable-collections-border-color: {{ settings.border_color }};
    --expandable-collections-border-width: {{ settings.border_width }}px;
    --expandable-collections-transition: {{ settings.transition_speed }}ms;
    --expandable-collections-max-width: {{ settings.max_width }}px;
  "
>
  <div class="expandable-collections__inner">
    {%- if settings.eyebrow != blank or settings.heading != blank or settings.subheading != blank -%}
      <div class="expandable-collections__header">
        {%- if settings.eyebrow != blank -%}
          <p class="expandable-collections__eyebrow">{{ settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if settings.heading != blank -%}
          <h2 class="expandable-collections__heading">{{ settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if settings.subheading != blank -%}
          <div class="expandable-collections__subheading">{{ settings.subheading }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="expandable-collections__cards" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign block_settings = block.settings
          assign card_collection = block_settings.collection
          assign card_url = block_settings.button_link
          if card_url == blank and card_collection != blank
            assign card_url = card_collection.url
          endif

          assign card_title = block_settings.title
          if card_title == blank and card_collection != blank
            assign card_title = card_collection.title
          endif
          if card_title == blank
            assign card_title = 'Collection'
          endif

          assign card_image = block_settings.image
          if card_image == blank and card_collection != blank
            assign card_image = card_collection.featured_image
          endif
          assign mobile_image = block_settings.mobile_image
          if mobile_image == blank
            assign mobile_image = card_image
          endif

          assign card_description = block_settings.description
          if card_description == blank and card_collection != blank
            assign card_description = card_collection.description
          endif

          assign card_overlay_opacity = settings.overlay_opacity | divided_by: 100.0
          if block_settings.overlay_opacity_override >= 0
            assign card_overlay_opacity = block_settings.overlay_opacity_override | divided_by: 100.0
          endif

          assign card_text_color = settings.text_color
          if block_settings.text_color_override != blank
            assign card_text_color = block_settings.text_color_override
          endif

          assign is_active = false
          if forloop.index == active_index
            assign is_active = true
          endif
        -%}

        <article
          class="expandable-collections__card{% if is_active %} is-active{% endif %}"
          role="listitem"
          data-expandable-card
          data-card-index="{{ forloop.index }}"
          style="--expandable-collections-card-overlay-opacity: {{ card_overlay_opacity }}; --expandable-collections-card-text: {{ card_text_color }}; --expandable-collections-image-position: {{ block_settings.image_position }};"
          {{ block.shopify_attributes }}
        >
          <div class="expandable-collections__media">
            {%- if card_image != blank -%}
              <picture>
                {%- if mobile_image != blank -%}
                  <source media="(max-width: 767px)" srcset="{{ mobile_image | image_url: width: 900 }}">
                {%- endif -%}
                {{ card_image | image_url: width: 1600 | image_tag: loading: 'lazy', class: 'expandable-collections__image', alt: card_title }}
              </picture>
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'expandable-collections__placeholder' }}
            {%- endif -%}
          </div>

          <button
            class="expandable-collections__toggle"
            type="button"
            aria-expanded="{% if is_active %}true{% else %}false{% endif %}"
            aria-controls="ExpandableCollectionsPanel-{{ section.id }}-{{ block.id }}"
            data-expandable-toggle
          >
            <span class="expandable-collections__collapsed-copy">
              {%- if block_settings.badge != blank -%}
                <span class="expandable-collections__badge">{{ block_settings.badge | escape }}</span>
              {%- endif -%}
              <span class="expandable-collections__collapsed-title">{{ card_title | escape }}</span>
              {%- if settings.show_collapsed_description and card_description != blank -%}
                <span class="expandable-collections__collapsed-description">{{ card_description | strip_html | truncate: 90 }}</span>
              {%- endif -%}
            </span>
            {%- if settings.show_collapsed_arrow -%}
              <span class="expandable-collections__arrow" aria-hidden="true"></span>
            {%- endif -%}
          </button>

          <div
            id="ExpandableCollectionsPanel-{{ section.id }}-{{ block.id }}"
            class="expandable-collections__panel"
            data-expandable-panel
          >
            <div class="expandable-collections__content">
              {%- if block_settings.icon != blank -%}
                {{ block_settings.icon | image_url: width: 96 | image_tag: loading: 'lazy', class: 'expandable-collections__icon', alt: '' }}
              {%- endif -%}
              {%- if block_settings.badge != blank -%}
                <p class="expandable-collections__card-eyebrow">{{ block_settings.badge | escape }}</p>
              {%- endif -%}
              <h3 class="expandable-collections__title">{{ card_title | escape }}</h3>
              {%- if card_description != blank -%}
                <div class="expandable-collections__description">{{ card_description }}</div>
              {%- endif -%}
              {%- if block_settings.button_label != blank and card_url != blank -%}
                <a
                  class="expandable-collections__button"
                  href="{{ card_url }}"
                  {% if block_settings.open_in_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                  data-expandable-link
                >
                  {{ block_settings.button_label | escape }}
                </a>
              {%- endif -%}
            </div>
          </div>

          {%- if settings.show_mobile_closed_cta and block_settings.button_label != blank and card_url != blank -%}
            <a
              class="expandable-collections__mobile-closed-link"
              href="{{ card_url }}"
              {% if block_settings.open_in_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
            >
              {{ block_settings.button_label | escape }}
            </a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Expandable cards",
  "tag": "section",
  "class": "shopify-section-expandable-collection-cards",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Featured collections"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by collection"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Highlight key collections with an interactive card layout.</p>"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Content max width",
      "min": 900,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background colour",
      "default": "#f7f3ef"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour",
      "default": "#c58b68"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay colour",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_desktop",
      "label": "Section padding desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_mobile",
      "label": "Section padding mobile",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "card_height_desktop",
      "label": "Card height desktop",
      "min": 320,
      "max": 760,
      "step": 20,
      "unit": "px",
      "default": 560
    },
    {
      "type": "range",
      "id": "card_closed_height_mobile",
      "label": "Card closed height mobile",
      "min": 96,
      "max": 260,
      "step": 8,
      "unit": "px",
      "default": 148
    },
    {
      "type": "range",
      "id": "card_expanded_height_mobile",
      "label": "Card expanded height mobile",
      "min": 320,
      "max": 720,
      "step": 20,
      "unit": "px",
      "default": 460
    },
    {
      "type": "range",
      "id": "active_card_width_desktop",
      "label": "Active card width desktop",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "inactive_card_width_desktop",
      "label": "Inactive card width desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "card_gap_desktop",
      "label": "Card gap desktop",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_gap_mobile",
      "label": "Card gap mobile",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "checkbox",
      "id": "card_shadow",
      "label": "Card shadow",
      "default": true
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border colour",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position for expanded cards",
      "default": "bottom-left",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "center", "label": "Center" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" },
        { "value": "bottom-right", "label": "Bottom right" }
      ]
    },
    {
      "type": "select",
      "id": "collapsed_content_position",
      "label": "Content position for collapsed cards",
      "default": "bottom",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ]
    },
    {
      "type": "header",
      "content": "Desktop behaviour"
    },
    {
      "type": "select",
      "id": "desktop_behaviour",
      "label": "Desktop behaviour",
      "default": "hover",
      "options": [
        { "value": "hover", "label": "Hover to expand" },
        { "value": "click", "label": "Click to expand" },
        { "value": "equal", "label": "No expand, equal cards" }
      ]
    },
    {
      "type": "range",
      "id": "default_active_card",
      "label": "Default active card",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "transition_speed",
      "label": "Transition speed",
      "min": 100,
      "max": 1200,
      "step": 50,
      "unit": "ms",
      "default": 450
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Auto-rotate",
      "default": false
    },
    {
      "type": "range",
      "id": "auto_rotate_delay",
      "label": "Auto-rotate delay",
      "min": 2,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "pause_auto_rotate_on_hover",
      "label": "Pause auto-rotate on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Mobile accordion"
    },
    {
      "type": "range",
      "id": "mobile_default_open_card",
      "label": "Mobile default open card",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 1,
      "info": "Set to 0 for all cards closed."
    },
    {
      "type": "checkbox",
      "id": "allow_multiple_open",
      "label": "Allow multiple open cards",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_collapsed_description",
      "label": "Show collapsed description",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_collapsed_arrow",
      "label": "Show collapsed arrow",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_mobile_closed_cta",
      "label": "Show CTA on mobile closed state",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image override"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title override"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Eyebrow or badge text"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop collection"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link override"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open in new tab",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon or small image"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image position",
          "default": "center center",
          "options": [
            { "value": "center center", "label": "Center" },
            { "value": "center top", "label": "Top" },
            { "value": "center bottom", "label": "Bottom" },
            { "value": "left center", "label": "Left" },
            { "value": "right center", "label": "Right" }
          ]
        },
        {
          "type": "range",
          "id": "overlay_opacity_override",
          "label": "Overlay opacity override",
          "min": 0,
          "max": 90,
          "step": 5,
          "unit": "%",
          "default": 35
        },
        {
          "type": "color",
          "id": "text_color_override",
          "label": "Text colour override",
          "default": "#ffffff"
        },
        {
          "type": "checkbox",
          "id": "set_as_default_active",
          "label": "Set as default active",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Expandable cards",
      "blocks": [
        {
          "type": "collection_card",
          "settings": {
            "title": "Collection one",
            "badge": "New arrivals",
            "description": "<p>Add a short description for this featured collection.</p>"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "title": "Collection two",
            "badge": "Essentials",
            "description": "<p>Use collection cards to guide shoppers into curated edits.</p>"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "title": "Collection three",
            "badge": "Limited edit",
            "description": "<p>Pair imagery, copy, and a clear call to action.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
