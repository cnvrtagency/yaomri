<script>
(function() {
  const section = document.querySelector('.instagram-feed--{{ section.id }}');
  if (!section) return;

  const title = section.querySelector('[data-title-highlight]');
  if (!title) return;

  const highlight = title.getAttribute('data-title-highlight').trim();
  const text = title.textContent;
  if (!highlight || !text) return;

  const matchIndex = text.toLocaleLowerCase().indexOf(highlight.toLocaleLowerCase());
  if (matchIndex < 0) return;

  const before = text.slice(0, matchIndex);
  const matched = text.slice(matchIndex, matchIndex + highlight.length);
  const after = text.slice(matchIndex + highlight.length);
  const fragment = document.createDocumentFragment();

  fragment.appendChild(document.createTextNode(before));

  const highlightNode = document.createElement('span');
  highlightNode.className = 'instagram-feed__title-highlight';
  highlightNode.textContent = matched;
  fragment.appendChild(highlightNode);

  fragment.appendChild(document.createTextNode(after));
  title.textContent = '';
  title.appendChild(fragment);
})();

(function() {
  const proxyUrl = 'https://black-darkness-b2ec.danlyons20.workers.dev';
  const token = '{{ section.settings.access_token }}';
  const igId = '{{ section.settings.ig_account_id }}';
  const desktopCount = Number({{ posts_shown_desktop }}) || 8;
  const mobileCount = Number({{ posts_shown_mobile }}) || 6;
  const isMobile = window.matchMedia('(max-width: 768px)').matches;
  const count = isMobile ? mobileCount : desktopCount;
  const grid = document.getElementById('instagram-grid');
  const section = grid ? grid.closest('.instagram-feed') : null;
  const cardStyle = {{ section.settings.card_style | default: 'image_only' | json }};
  const avatarText = {{ section.settings.post_card_avatar_text | default: 'YO' | json }};
  const handleText = {{ section.settings.post_card_handle_text | default: '@yaomriswimwear' | json }};
  const viewText = {{ section.settings.post_card_view_text | default: 'View on Instagram' | json }};
  const showPostTopbar = {% if section.settings.post_card_show_topbar == false %}false{% else %}true{% endif %};
  const showPostActions = {% if section.settings.post_card_show_actions == false %}false{% else %}true{% endif %};
  const showPostViewText = {% if section.settings.post_card_show_view_text %}true{% else %}false{% endif %};
  const isMarquee = Boolean(section && (
    isMobile
      ? section.classList.contains('instagram-feed--mobile-marquee')
      : section.classList.contains('instagram-feed--desktop-marquee')
  ));
  const escapeHtml = (value) => String(value || '').replace(/[&<>"']/g, (char) => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;'
  }[char]));

  if (!token || !igId) {
    grid.innerHTML = '<div class="instagram-feed__loading">Add your Instagram token in section settings.</div>';
    return;
  }

  fetch(`${proxyUrl}/?token=${encodeURIComponent(token)}&ig_id=${igId}&count=${count}`)
    .then(r => r.json())
    .then(data => {
      if (!data.data || data.error) {
        grid.innerHTML = '<div class="instagram-feed__loading">Could not load feed.</div>';
        return;
      }
      const posts = data.data.slice(0, count);
      const renderPost = (post, isClone = false) => {
        const rawImg = post.media_type === 'VIDEO' ? post.thumbnail_url : post.media_url;
        const img = `${proxyUrl}/image?url=${encodeURIComponent(rawImg)}`;
        const isVideo = post.media_type === 'VIDEO';
        const isCarousel = post.media_type === 'CAROUSEL_ALBUM';
        const cloneAttrs = isClone ? ' aria-hidden="true" tabindex="-1" data-marquee-clone="true"' : '';
        const cloneClass = isClone ? ' instagram-feed__item--duplicate' : '';
        const badgeMarkup = `
          ${isVideo ? '<span class="instagram-feed__video-badge">Reel</span>' : ''}
          ${isCarousel ? '<span class="instagram-feed__video-badge">Album</span>' : ''}
        `;

        if (cardStyle === 'instagram_post') {
          return `
            <a href="${post.permalink}" target="_blank" class="instagram-feed__item instagram-feed__item--post-card${cloneClass}"${cloneAttrs}>
              ${showPostTopbar ? `
                <span class="instagram-feed__post-topbar">
                  <span class="instagram-feed__post-identity">
                    <span class="instagram-feed__post-avatar">${escapeHtml(avatarText)}</span>
                    <span class="instagram-feed__post-handle">${escapeHtml(handleText)}</span>
                  </span>
                  <span class="instagram-feed__post-menu" aria-hidden="true">...</span>
                </span>
              ` : ''}
              <span class="instagram-feed__post-media">
                <img src="${img}" alt="Instagram" loading="lazy">
                <span class="instagram-feed__overlay">
                  <svg class="instagram-feed__overlay-icon" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
                </span>
                ${badgeMarkup}
              </span>
              ${showPostActions ? `
                <span class="instagram-feed__post-actions">
                  <span class="instagram-feed__post-actions-left">
                    <span class="instagram-feed__post-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.4 5.4 0 0 0-7.6 0L12 5.8l-1.2-1.2a5.4 5.4 0 1 0-7.6 7.6L12 21l8.8-8.8a5.4 5.4 0 0 0 0-7.6z"/></svg></span>
                    <span class="instagram-feed__post-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.6 8.6 0 0 1-3.7-.8L3 21l1.8-5.1a8.3 8.3 0 0 1-1-4A8.5 8.5 0 0 1 12.3 3 8.4 8.4 0 0 1 21 11.5z"/></svg></span>
                    <span class="instagram-feed__post-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13"/><path d="m22 2-7 20-4-9-9-4 20-7z"/></svg></span>
                  </span>
                  <span class="instagram-feed__post-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21 12 17 5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg></span>
                </span>
              ` : ''}
              ${showPostViewText ? `<span class="instagram-feed__post-view-text">${escapeHtml(viewText)}</span>` : ''}
            </a>
          `;
        }

        return `
          <a href="${post.permalink}" target="_blank" class="instagram-feed__item${cloneClass}"${cloneAttrs}>
            <img src="${img}" alt="Instagram" loading="lazy">
            <div class="instagram-feed__overlay">
              <svg class="instagram-feed__overlay-icon" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
            </div>
            ${badgeMarkup}
          </a>
        `;
      };
      const renderedItems = posts.map(post => renderPost(post)).join('');
      const duplicatedItems = posts.map(post => renderPost(post, true)).join('');
      grid.innerHTML = '';
      grid.innerHTML = isMarquee ? renderedItems + duplicatedItems : renderedItems;
    })
    .catch(() => {
      grid.innerHTML = '<div class="instagram-feed__loading">Could not load feed.</div>';
    });
})();

(function() {
  const section = document.querySelector('.instagram-feed--{{ section.id }}');
  if (!section) return;

  const grid = section.querySelector('#instagram-grid');
  const controls = section.querySelectorAll('[data-instagram-arrow]');
  if (!grid || !controls.length) return;

  controls.forEach((control) => {
    control.addEventListener('click', () => {
      const direction = control.getAttribute('data-instagram-arrow') === 'prev' ? -1 : 1;
      const distance = Math.max(grid.clientWidth * 0.8, 240);
      grid.scrollBy({ left: direction * distance, behavior: 'smooth' });
    });
  });
})();
</script>

