{%- liquid
  assign layout_style = section.settings.layout_style | default: 'split'
  assign desktop_display_mode = section.settings.desktop_display_mode | default: 'grid'
  assign mobile_display_mode = section.settings.mobile_display_mode | default: 'carousel'
  assign image_aspect_ratio = section.settings.image_aspect_ratio | default: 'square'
  assign cta_label = section.settings.cta_label | default: ''
  if cta_label == blank
    assign cta_label = 'Follow @' | append: section.settings.handle
  endif
  assign handle_display_text = section.settings.handle_display_text
  if handle_display_text == blank and section.settings.handle != blank
    assign handle_display_text = '@' | append: section.settings.handle
  endif
  assign title_text = section.settings.title
  assign title_highlight_text = section.settings.title_highlight_text | strip
  assign title_has_highlight = false
  if section.settings.title_dual_colour_enable and title_text != blank and title_highlight_text != blank
    assign title_has_highlight = true
  endif
  assign posts_shown_desktop = section.settings.posts_shown_desktop | default: 8 | plus: 0
  assign posts_shown_mobile = section.settings.posts_shown_mobile | default: 6 | plus: 0
-%}

<section
  class="instagram-feed instagram-feed--{{ section.id }} instagram-feed--layout-{{ layout_style }} instagram-feed--desktop-{{ desktop_display_mode }} instagram-feed--mobile-{{ mobile_display_mode }} instagram-feed--aspect-{{ image_aspect_ratio }} instagram-feed--card-{{ section.settings.card_style | default: 'image_only' }} instagram-feed--title-highlight-{{ section.settings.title_highlight_style | default: 'text_colour' }} instagram-feed--marquee-{{ section.settings.marquee_direction | default: 'left' }} instagram-feed--text-desktop-{{ section.settings.text_align_desktop | default: 'left' }} instagram-feed--text-mobile-{{ section.settings.text_align_mobile | default: 'center' }}{% if section.settings.carousel_snap %} instagram-feed--snap{% endif %}{% if section.settings.marquee_pause_on_hover != false %} instagram-feed--marquee-pause{% endif %}{% if section.settings.marquee_fade_edges != false %} instagram-feed--marquee-fade{% endif %}"
  style="
    --instagram-posts-desktop: {{ section.settings.posts_per_row_desktop | default: section.settings.columns | default: 4 }};
    --instagram-posts-tablet: {{ section.settings.posts_per_row_tablet | default: 3 }};
    --instagram-posts-mobile: {{ section.settings.posts_per_row_mobile | default: 2 }};
    --instagram-gap: {{ section.settings.gap | default: 4 }}px;
    --instagram-carousel-gap: {{ section.settings.carousel_gap | default: 8 }}px;
    --instagram-carousel-peek: {{ section.settings.carousel_peek | default: 24 }}px;
    --instagram-marquee-speed-desktop: {{ section.settings.marquee_speed_desktop | default: 28 }}s;
    --instagram-marquee-speed-mobile: {{ section.settings.marquee_speed_mobile | default: 24 }}s;
    --instagram-marquee-fade-width: {{ section.settings.marquee_fade_width | default: 48 }}px;
    --instagram-marquee-gap: {{ section.settings.marquee_gap | default: 12 }}px;
    --instagram-card-radius: {{ section.settings.card_radius | default: 0 }}px;
    --instagram-card-size-desktop: {{ section.settings.card_size_desktop | default: 260 }}px;
    --instagram-card-size-tablet: {{ section.settings.card_size_tablet | default: 220 }}px;
    --instagram-card-size-mobile: {{ section.settings.card_size_mobile | default: 160 }}px;
    --instagram-post-card-bg: {{ section.settings.post_card_bg_color | default: '#ffffff' }};
    --instagram-post-card-border: {{ section.settings.post_card_border_color | default: '#e8e1da' }};
    --instagram-post-card-text: {{ section.settings.post_card_text_color | default: '#111111' }};
    --instagram-post-card-icon: {{ section.settings.post_card_icon_color | default: '#111111' }};
    --instagram-post-card-avatar-bg: {{ section.settings.post_card_avatar_bg_color | default: '#fff4f4' }};
    --instagram-post-card-padding: {{ section.settings.post_card_padding | default: 10 }}px;
    --instagram-post-card-icon-size: {{ section.settings.post_card_icon_size | default: 20 }}px;
    --instagram-section-padding-desktop: {{ section.settings.section_padding_desktop | default: 72 }}px;
    --instagram-section-padding-mobile: {{ section.settings.section_padding_mobile | default: 44 }}px;
    --instagram-padding-x-desktop: {{ section.settings.padding_x_desktop | default: 48 }}px;
    --instagram-padding-x-tablet: {{ section.settings.padding_x_tablet | default: 32 }}px;
    --instagram-padding-x-mobile: {{ section.settings.padding_x_mobile | default: 20 }}px;
    --instagram-intro-width: {{ section.settings.intro_width | default: 34 }}%;
    --instagram-split-gap: {{ section.settings.split_column_gap | default: 8 }}px;
    --instagram-split-align: {% if section.settings.intro_vertical_align == 'top' %}start{% else %}center{% endif %};
    --instagram-bg: {{ section.settings.background_color | default: '#000000' }};
    --instagram-text: {{ section.settings.text_color | default: '#ffffff' }};
    --instagram-accent: {{ section.settings.accent_color | default: '#fff4f4' }};
    --instagram-title-color-1: {% if section.settings.title_dual_colour_enable %}{{ section.settings.title_colour_1 | default: section.settings.text_color | default: '#ffffff' }}{% else %}{{ section.settings.text_color | default: '#ffffff' }}{% endif %};
    --instagram-title-color-2: {{ section.settings.title_colour_2 | default: '#c9a6a0' }};
    --instagram-title-badge-text: {{ section.settings.title_badge_text_color | default: '#111111' }};
    --instagram-title-badge-bg: {{ section.settings.title_badge_bg_color | default: '#ffffff' }};
    --instagram-title-badge-border: {{ section.settings.title_badge_border_color | default: '#ffffff' }};
    --instagram-title-badge-radius: {{ section.settings.title_badge_radius | default: 24 }}px;
    --instagram-title-badge-padding-x: {{ section.settings.title_badge_padding_x | default: 10 }}px;
    --instagram-title-badge-padding-y: {{ section.settings.title_badge_padding_y | default: 4 }}px;
    --instagram-title-badge-border-width: {{ section.settings.title_badge_border_width | default: 0 }}px;
    --instagram-eyebrow-size: {{ section.settings.eyebrow_font_size | default: 12 }}px;
    --instagram-eyebrow-weight: {{ section.settings.eyebrow_font_weight | default: 700 }};
    --instagram-eyebrow-letter-spacing: {{ section.settings.eyebrow_letter_spacing | default: 2 }}px;
    --instagram-eyebrow-spacing-bottom: {{ section.settings.eyebrow_spacing_bottom | default: 10 }}px;
    --instagram-title-size-desktop: {{ section.settings.title_font_size_desktop | default: 56 }}px;
    --instagram-title-size-mobile: {{ section.settings.title_font_size_mobile | default: 36 }}px;
    --instagram-title-weight: {{ section.settings.title_font_weight | default: 800 }};
    --instagram-title-line-height: {{ section.settings.title_line_height | default: 1.0 }};
    --instagram-title-letter-spacing: {{ section.settings.title_letter_spacing | default: 0 }}px;
    --instagram-body-size: {{ section.settings.body_font_size | default: 15 }}px;
    --instagram-body-size-mobile: {{ section.settings.body_font_size_mobile | default: 14 }}px;
    --instagram-body-line-height: {{ section.settings.body_line_height | default: 1.6 }};
    --instagram-body-weight: {{ section.settings.body_font_weight | default: 400 }};
    --instagram-handle-size: {{ section.settings.handle_font_size | default: 13 }}px;
    --instagram-handle-weight: {{ section.settings.handle_font_weight | default: 700 }};
    --instagram-handle-letter-spacing: {{ section.settings.handle_letter_spacing | default: 1.6 }}px;
    --instagram-heading-width-desktop: {{ section.settings.heading_width_desktop | default: 520 }}px;
    --instagram-heading-width-mobile: {{ section.settings.heading_width_mobile | default: 340 }}px;
    --instagram-body-width-desktop: {{ section.settings.body_width_desktop | default: 420 }}px;
    --instagram-body-width-mobile: {{ section.settings.body_width_mobile | default: 340 }}px;
    --instagram-cta-size-desktop: {{ section.settings.cta_font_size_desktop | default: section.settings.cta_font_size | default: 12 }}px;
    --instagram-cta-size-mobile: {{ section.settings.cta_font_size_mobile | default: 11 }}px;
    --instagram-cta-weight: {{ section.settings.cta_font_weight | default: 700 }};
    --instagram-cta-letter-spacing: {{ section.settings.cta_letter_spacing | default: 1.8 }}px;
    --instagram-cta-text-transform: {% if section.settings.cta_uppercase != false %}uppercase{% else %}none{% endif %};
    --instagram-cta-padding-x-desktop: {{ section.settings.cta_padding_x_desktop | default: 28 }}px;
    --instagram-cta-padding-y-desktop: {{ section.settings.cta_padding_y_desktop | default: 11 }}px;
    --instagram-cta-padding-x-mobile: {{ section.settings.cta_padding_x_mobile | default: 22 }}px;
    --instagram-cta-padding-y-mobile: {{ section.settings.cta_padding_y_mobile | default: 10 }}px;
    --instagram-cta-text-color: {{ section.settings.cta_text_color | default: '#ffffff' }};
    --instagram-cta-border-color: {{ section.settings.cta_border_color | default: '#ffffff' }};
    --instagram-cta-bg-color: {{ section.settings.cta_background_color | default: 'transparent' }};
    --instagram-cta-hover-text-color: {{ section.settings.cta_hover_text_color | default: '#111111' }};
    --instagram-cta-hover-bg-color: {{ section.settings.cta_hover_background_color | default: '#ffffff' }};
    --instagram-cta-radius: {{ section.settings.cta_radius | default: 0 }}px;
    --instagram-eyebrow-icon-size: {{ section.settings.eyebrow_icon_size | default: 14 }}px;
    --instagram-eyebrow-icon-gap: {{ section.settings.eyebrow_icon_gap | default: 8 }}px;
    --instagram-eyebrow-icon-color: {{ section.settings.eyebrow_icon_color | default: section.settings.accent_color | default: '#ffffff' }};
    --instagram-text-align-desktop: {{ section.settings.text_align_desktop | default: 'left' }};
    --instagram-text-align-mobile: {{ section.settings.text_align_mobile | default: 'center' }};
  "
>
  <div class="container">
    <div class="instagram-feed__inner">
      <div class="instagram-feed__intro">
        {% if section.settings.eyebrow != blank %}
          <p class="instagram-feed__eyebrow">
            {% if section.settings.show_eyebrow_icon != false and section.settings.eyebrow_icon_style == 'instagram' %}
              <span class="instagram-feed__eyebrow-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                  <circle cx="12" cy="12" r="4"></circle>
                  <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
                </svg>
              </span>
            {% endif %}
            <span>{{ section.settings.eyebrow }}</span>
          </p>
        {% endif %}

        {% if section.settings.title != blank %}
          <h2
            class="instagram-feed__title"
            {% if title_has_highlight %}data-title-highlight="{{ title_highlight_text | escape }}"{% endif %}
          >
            {{ section.settings.title | escape }}
          </h2>
        {% endif %}

        {% if section.settings.body_text != blank %}
          <div class="instagram-feed__body">{{ section.settings.body_text }}</div>
        {% endif %}

        {% if section.settings.show_handle_text != false and handle_display_text != blank %}
          <p class="instagram-feed__handle">{{ handle_display_text | escape }}</p>
        {% endif %}

        {% if section.settings.show_follow %}
          <div class="instagram-feed__footer instagram-feed__footer--intro">
            <a href="https://instagram.com/{{ section.settings.handle }}" target="_blank" rel="noopener" class="instagram-feed__follow">
              {{ cta_label }}
            </a>
          </div>
        {% endif %}
      </div>

      <div class="instagram-feed__media">
        {% if section.settings.show_carousel_arrows %}
          <div class="instagram-feed__arrows">
            <button class="instagram-feed__arrow instagram-feed__arrow--prev" type="button" data-instagram-arrow="prev" aria-label="Previous Instagram posts">
              <span aria-hidden="true">&larr;</span>
            </button>
            <button class="instagram-feed__arrow instagram-feed__arrow--next" type="button" data-instagram-arrow="next" aria-label="Next Instagram posts">
              <span aria-hidden="true">&rarr;</span>
            </button>
          </div>
        {% endif %}

        <div class="instagram-feed__grid" id="instagram-grid">
          <div class="instagram-feed__loading">Loading...</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.instagram-feed {
  padding: var(--instagram-section-padding-desktop) 0;
  background: var(--instagram-bg);
  color: var(--instagram-text);
  overflow-x: hidden;
}
.instagram-feed > .container {
  box-sizing: border-box;
  width: 100%;
  padding-inline: var(--instagram-padding-x-desktop);
}
.instagram-feed__inner {
  display: grid;
  gap: var(--instagram-split-gap);
  align-items: start;
  min-width: 0;
}
.instagram-feed--layout-split .instagram-feed__inner {
  grid-template-columns: minmax(0, var(--instagram-intro-width)) minmax(0, 1fr);
  align-items: var(--instagram-split-align);
}
.instagram-feed--layout-grid .instagram-feed__inner {
  grid-template-columns: minmax(0, 1fr);
  align-items: start;
}
.instagram-feed--layout-grid .instagram-feed__intro {
  max-width: var(--instagram-heading-width-desktop);
  margin-inline: auto;
  width: 100%;
}
.instagram-feed__intro {
  min-width: 0;
  width: 100%;
  max-width: var(--instagram-heading-width-desktop);
  text-align: var(--instagram-text-align-desktop);
}
.instagram-feed--layout-grid .instagram-feed__intro {
  text-align: var(--instagram-text-align-desktop);
}
.instagram-feed__intro > * {
  min-width: 0;
}
.instagram-feed__intro {
  overflow-wrap: anywhere;
  overflow: hidden;
}
.instagram-feed__title,
.instagram-feed__body,
.instagram-feed__handle,
.instagram-feed__footer {
  max-width: 100%;
}
.instagram-feed__intro {
  container-type: inline-size;
}
.instagram-feed__eyebrow {
  display: inline-flex;
  align-items: center;
  justify-content: flex-start;
  gap: var(--instagram-eyebrow-icon-gap);
  margin: 0 0 var(--instagram-eyebrow-spacing-bottom);
  font-size: var(--instagram-eyebrow-size);
  font-weight: var(--instagram-eyebrow-weight);
  letter-spacing: var(--instagram-eyebrow-letter-spacing);
  text-transform: uppercase;
  color: var(--instagram-accent);
}
.instagram-feed--text-desktop-center .instagram-feed__eyebrow {
  justify-content: center;
}
.instagram-feed__eyebrow-icon {
  display: inline-flex;
  flex: 0 0 auto;
  width: var(--instagram-eyebrow-icon-size);
  height: var(--instagram-eyebrow-icon-size);
  color: var(--instagram-eyebrow-icon-color);
}
.instagram-feed__eyebrow-icon svg {
  display: block;
  width: 100%;
  height: 100%;
}
.instagram-feed__title {
  margin: 0;
  width: min(100%, var(--instagram-heading-width-desktop));
  max-width: min(100%, var(--instagram-heading-width-desktop));
  color: var(--instagram-title-color-1);
  font-size: var(--instagram-title-size-desktop);
  font-weight: var(--instagram-title-weight);
  font-style: italic;
  line-height: var(--instagram-title-line-height);
  letter-spacing: var(--instagram-title-letter-spacing);
  text-transform: uppercase;
  overflow-wrap: anywhere;
  word-break: normal;
}
.instagram-feed__title-highlight {
  color: var(--instagram-title-color-2);
}
.instagram-feed--title-highlight-badge .instagram-feed__title-highlight {
  display: inline-flex;
  align-items: center;
  color: var(--instagram-title-badge-text);
  background: var(--instagram-title-badge-bg);
  border: var(--instagram-title-badge-border-width) solid var(--instagram-title-badge-border);
  border-radius: var(--instagram-title-badge-radius);
  padding: var(--instagram-title-badge-padding-y) var(--instagram-title-badge-padding-x);
  line-height: 1;
  vertical-align: baseline;
}
.instagram-feed--layout-grid .instagram-feed__title {
  max-width: min(100%, var(--instagram-heading-width-desktop));
}
.instagram-feed--layout-grid .instagram-feed__title,
.instagram-feed--layout-grid .instagram-feed__body {
  margin-inline: 0;
}
.instagram-feed--text-desktop-center .instagram-feed__title,
.instagram-feed--text-desktop-center .instagram-feed__body {
  margin-inline: auto;
}
.instagram-feed__body {
  width: min(100%, var(--instagram-body-width-desktop));
  max-width: min(100%, var(--instagram-body-width-desktop));
  margin-top: 18px;
  color: var(--instagram-text);
  font-size: var(--instagram-body-size);
  font-weight: var(--instagram-body-weight);
  line-height: var(--instagram-body-line-height);
  overflow-wrap: anywhere;
}
.instagram-feed__body p {
  margin: 0 0 12px;
}
.instagram-feed__body p:last-child {
  margin-bottom: 0;
}
.instagram-feed__handle {
  margin: 18px 0 0;
  color: var(--instagram-accent);
  font-size: var(--instagram-handle-size);
  font-weight: var(--instagram-handle-weight);
  letter-spacing: var(--instagram-handle-letter-spacing);
  text-transform: uppercase;
  overflow-wrap: anywhere;
}
.instagram-feed__media {
  position: relative;
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
}
.instagram-feed__grid {
  max-width: 100%;
  min-width: 0;
}
.instagram-feed--desktop-grid .instagram-feed__grid {
  display: grid;
  grid-template-columns: repeat(var(--instagram-posts-desktop), minmax(0, 1fr));
  column-gap: var(--instagram-gap);
  row-gap: var(--instagram-gap);
  overflow: visible;
  align-items: start;
}
.instagram-feed__item {
  position: relative;
  display: block;
  overflow: hidden;
  aspect-ratio: 1;
  border-radius: var(--instagram-card-radius);
  background: #fff4f4;
  color: inherit;
}
.instagram-feed--desktop-grid .instagram-feed__item {
  width: 100%;
  max-width: none;
  justify-self: stretch;
}
.instagram-feed--aspect-portrait .instagram-feed__item {
  aspect-ratio: 4 / 5;
}
.instagram-feed--aspect-landscape .instagram-feed__item {
  aspect-ratio: 4 / 3;
}
.instagram-feed--card-instagram_post .instagram-feed__item {
  display: flex;
  flex-direction: column;
  aspect-ratio: auto;
  padding: var(--instagram-post-card-padding);
  border: 1px solid var(--instagram-post-card-border);
  background: var(--instagram-post-card-bg);
  color: var(--instagram-post-card-text);
}
.instagram-feed--card-instagram_post .instagram-feed__item:hover {
  color: var(--instagram-post-card-text);
}
.instagram-feed__post-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding-bottom: var(--instagram-post-card-padding);
  color: var(--instagram-post-card-text);
}
.instagram-feed__post-identity {
  display: inline-flex;
  align-items: center;
  min-width: 0;
  gap: 9px;
}
.instagram-feed__post-avatar {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: var(--instagram-post-card-avatar-bg);
  color: var(--instagram-post-card-text);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .04em;
  text-transform: uppercase;
}
.instagram-feed__post-handle {
  min-width: 0;
  overflow: hidden;
  color: var(--instagram-post-card-text);
  font-size: 12px;
  font-weight: 700;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.instagram-feed__post-menu {
  flex: 0 0 auto;
  color: var(--instagram-post-card-icon);
  font-size: 19px;
  font-weight: 700;
  line-height: 1;
  letter-spacing: .08em;
}
.instagram-feed__post-media {
  position: relative;
  display: block;
  overflow: hidden;
  aspect-ratio: 1;
  border-radius: max(0px, calc(var(--instagram-card-radius) - var(--instagram-post-card-padding)));
  background: #fff4f4;
}
.instagram-feed--aspect-portrait .instagram-feed__post-media {
  aspect-ratio: 4 / 5;
}
.instagram-feed--aspect-landscape .instagram-feed__post-media {
  aspect-ratio: 4 / 3;
}
.instagram-feed__post-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.instagram-feed__post-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding-top: var(--instagram-post-card-padding);
  color: var(--instagram-post-card-icon);
}
.instagram-feed__post-actions-left {
  display: inline-flex;
  align-items: center;
  gap: 12px;
}
.instagram-feed__post-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: var(--instagram-post-card-icon-size);
  height: var(--instagram-post-card-icon-size);
  color: var(--instagram-post-card-icon);
}
.instagram-feed__post-icon svg {
  display: block;
  width: 100%;
  height: 100%;
}
.instagram-feed__post-view-text {
  display: block;
  padding-top: calc(var(--instagram-post-card-padding) * .8);
  color: var(--instagram-post-card-text);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .08em;
  line-height: 1.2;
  text-transform: uppercase;
}
.instagram-feed__item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.4s ease;
}
.instagram-feed__item:hover img {
  transform: scale(1.04);
}
.instagram-feed__overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.3s ease;
}
.instagram-feed__item:hover .instagram-feed__overlay {
  background: rgba(0, 0, 0, 0.45);
}
.instagram-feed__overlay-icon {
  opacity: 0;
  transform: scale(0.8);
  transition: all 0.3s ease;
  color: #fff;
  font-size: 28px;
}
.instagram-feed__item:hover .instagram-feed__overlay-icon {
  opacity: 1;
  transform: scale(1);
}
.instagram-feed__video-badge {
  position: absolute;
  top: 8px;
  right: 8px;
  background: rgba(0,0,0,0.62);
  color: #fff;
  font-size: 10px;
  font-weight: 700;
  padding: 3px 7px;
  border-radius: 3px;
  text-transform: uppercase;
  letter-spacing: .08em;
}
.instagram-feed__footer {
  margin-top: 28px;
  text-align: var(--instagram-text-align-desktop);
}
.instagram-feed--layout-grid .instagram-feed__footer {
  text-align: var(--instagram-text-align-desktop);
}
.instagram-feed__follow {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1px solid var(--instagram-cta-border-color);
  border-radius: var(--instagram-cta-radius);
