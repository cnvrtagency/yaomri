{%- liquid
  assign layout_style = section.settings.layout_style | default: 'split'
  assign desktop_display_mode = section.settings.desktop_display_mode | default: 'grid'
  assign mobile_display_mode = section.settings.mobile_display_mode | default: 'carousel'
  assign image_aspect_ratio = section.settings.image_aspect_ratio | default: 'square'
  assign cta_label = section.settings.cta_label | default: ''
  if cta_label == blank
    assign cta_label = 'Follow @' | append: section.settings.handle
  endif
-%}

<section
  class="instagram-feed instagram-feed--{{ section.id }} instagram-feed--layout-{{ layout_style }} instagram-feed--desktop-{{ desktop_display_mode }} instagram-feed--mobile-{{ mobile_display_mode }} instagram-feed--aspect-{{ image_aspect_ratio }}{% if section.settings.carousel_snap %} instagram-feed--snap{% endif %}"
  style="
    --instagram-posts-desktop: {{ section.settings.posts_per_row_desktop | default: section.settings.columns | default: 4 }};
    --instagram-posts-tablet: {{ section.settings.posts_per_row_tablet | default: 3 }};
    --instagram-posts-mobile: {{ section.settings.posts_per_row_mobile | default: 2 }};
    --instagram-gap: {{ section.settings.gap | default: 4 }}px;
    --instagram-carousel-gap: {{ section.settings.carousel_gap | default: 8 }}px;
    --instagram-carousel-peek: {{ section.settings.carousel_peek | default: 24 }}px;
    --instagram-card-radius: {{ section.settings.card_radius | default: 0 }}px;
    --instagram-section-padding-desktop: {{ section.settings.section_padding_desktop | default: 72 }}px;
    --instagram-section-padding-mobile: {{ section.settings.section_padding_mobile | default: 44 }}px;
    --instagram-padding-x-desktop: {{ section.settings.padding_x_desktop | default: 48 }}px;
    --instagram-padding-x-tablet: {{ section.settings.padding_x_tablet | default: 32 }}px;
    --instagram-padding-x-mobile: {{ section.settings.padding_x_mobile | default: 20 }}px;
    --instagram-intro-width: {{ section.settings.intro_width | default: 34 }}%;
    --instagram-split-gap: {{ section.settings.split_column_gap | default: 48 }}px;
    --instagram-bg: {{ section.settings.background_color | default: '#000000' }};
    --instagram-text: {{ section.settings.text_color | default: '#ffffff' }};
    --instagram-accent: {{ section.settings.accent_color | default: '#fff4f4' }};
    --instagram-eyebrow-size: {{ section.settings.eyebrow_font_size | default: 12 }}px;
    --instagram-eyebrow-weight: {{ section.settings.eyebrow_font_weight | default: 700 }};
    --instagram-eyebrow-letter-spacing: {{ section.settings.eyebrow_letter_spacing | default: 2 }}px;
    --instagram-title-size-desktop: {{ section.settings.title_font_size_desktop | default: 56 }}px;
    --instagram-title-size-mobile: {{ section.settings.title_font_size_mobile | default: 36 }}px;
    --instagram-title-weight: {{ section.settings.title_font_weight | default: 800 }};
    --instagram-title-line-height: {{ section.settings.title_line_height | default: 0.95 }};
    --instagram-title-letter-spacing: {{ section.settings.title_letter_spacing | default: 0 }}px;
    --instagram-body-size: {{ section.settings.body_font_size | default: 15 }}px;
    --instagram-body-line-height: {{ section.settings.body_line_height | default: 1.6 }};
    --instagram-body-weight: {{ section.settings.body_font_weight | default: 400 }};
    --instagram-handle-size: {{ section.settings.handle_font_size | default: 13 }}px;
    --instagram-handle-weight: {{ section.settings.handle_font_weight | default: 700 }};
    --instagram-handle-letter-spacing: {{ section.settings.handle_letter_spacing | default: 1.6 }}px;
    --instagram-cta-size: {{ section.settings.cta_font_size | default: 12 }}px;
    --instagram-cta-weight: {{ section.settings.cta_font_weight | default: 700 }};
    --instagram-cta-letter-spacing: {{ section.settings.cta_letter_spacing | default: 1.8 }}px;
    --instagram-cta-text-transform: {% if section.settings.cta_uppercase != false %}uppercase{% else %}none{% endif %};
    --instagram-text-align-desktop: {{ section.settings.text_align_desktop | default: 'left' }};
    --instagram-text-align-mobile: {{ section.settings.text_align_mobile | default: 'center' }};
  "
>
  <div class="container">
    <div class="instagram-feed__inner">
      <div class="instagram-feed__intro">
        {% if section.settings.eyebrow != blank %}
          <p class="instagram-feed__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.title != blank %}
          <h2 class="instagram-feed__title">{{ section.settings.title }}</h2>
        {% endif %}

        {% if section.settings.body_text != blank %}
          <div class="instagram-feed__body">{{ section.settings.body_text }}</div>
        {% endif %}

        {% if section.settings.handle != blank %}
          <p class="instagram-feed__handle">@{{ section.settings.handle }}</p>
        {% endif %}

        {% if section.settings.show_follow %}
          <div class="instagram-feed__footer instagram-feed__footer--intro">
            <a href="https://instagram.com/{{ section.settings.handle }}" target="_blank" rel="noopener" class="instagram-feed__follow">
              {{ cta_label }}
            </a>
          </div>
        {% endif %}
      </div>

      <div class="instagram-feed__media">
        {% if section.settings.show_carousel_arrows %}
          <div class="instagram-feed__arrows">
            <button class="instagram-feed__arrow instagram-feed__arrow--prev" type="button" data-instagram-arrow="prev" aria-label="Previous Instagram posts">
              <span aria-hidden="true">&larr;</span>
            </button>
            <button class="instagram-feed__arrow instagram-feed__arrow--next" type="button" data-instagram-arrow="next" aria-label="Next Instagram posts">
              <span aria-hidden="true">&rarr;</span>
            </button>
          </div>
        {% endif %}

        <div class="instagram-feed__grid" id="instagram-grid">
          <div class="instagram-feed__loading">Loading...</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.instagram-feed {
  padding: var(--instagram-section-padding-desktop) 0;
  background: var(--instagram-bg);
  color: var(--instagram-text);
  overflow-x: hidden;
}
.instagram-feed > .container {
  box-sizing: border-box;
  width: 100%;
  padding-inline: var(--instagram-padding-x-desktop);
}
.instagram-feed__inner {
  display: grid;
  gap: var(--instagram-split-gap);
  align-items: center;
  min-width: 0;
}
.instagram-feed--layout-split .instagram-feed__inner {
  grid-template-columns: minmax(0, min(var(--instagram-intro-width), 520px)) minmax(0, 1fr);
}
.instagram-feed--layout-grid .instagram-feed__inner {
  grid-template-columns: minmax(0, 1fr);
}
.instagram-feed--layout-grid .instagram-feed__intro {
  max-width: 760px;
  margin: 0 auto;
}
.instagram-feed__intro {
  min-width: 0;
  max-width: 520px;
  text-align: var(--instagram-text-align-desktop);
}
.instagram-feed--layout-grid .instagram-feed__intro {
  text-align: var(--instagram-text-align-desktop);
}
.instagram-feed__intro > * {
  min-width: 0;
}
.instagram-feed__intro {
  overflow-wrap: anywhere;
  overflow: hidden;
}
.instagram-feed__title,
.instagram-feed__body,
.instagram-feed__handle,
.instagram-feed__footer {
  max-width: 100%;
}
.instagram-feed__intro {
  container-type: inline-size;
}
.instagram-feed__eyebrow {
  margin: 0 0 10px;
  font-size: var(--instagram-eyebrow-size);
  font-weight: var(--instagram-eyebrow-weight);
  letter-spacing: var(--instagram-eyebrow-letter-spacing);
  text-transform: uppercase;
  color: var(--instagram-accent);
}
.instagram-feed__title {
  margin: 0;
  max-width: 100%;
  color: var(--instagram-text);
  font-size: var(--instagram-title-size-desktop);
  font-weight: var(--instagram-title-weight);
  font-style: italic;
  line-height: var(--instagram-title-line-height);
  letter-spacing: var(--instagram-title-letter-spacing);
  text-transform: uppercase;
  overflow-wrap: anywhere;
  word-break: normal;
}
.instagram-feed--layout-grid .instagram-feed__title {
  max-width: none;
}
.instagram-feed--layout-grid .instagram-feed__title,
.instagram-feed--layout-grid .instagram-feed__body {
  margin-inline: auto;
}
.instagram-feed__body {
  max-width: 34em;
  margin-top: 18px;
  color: var(--instagram-text);
  opacity: .78;
  font-size: var(--instagram-body-size);
  font-weight: var(--instagram-body-weight);
  line-height: var(--instagram-body-line-height);
  overflow-wrap: anywhere;
}
.instagram-feed__body p {
  margin: 0 0 12px;
}
.instagram-feed__body p:last-child {
  margin-bottom: 0;
}
.instagram-feed__handle {
  margin: 18px 0 0;
  color: var(--instagram-accent);
  font-size: var(--instagram-handle-size);
  font-weight: var(--instagram-handle-weight);
  letter-spacing: var(--instagram-handle-letter-spacing);
  text-transform: uppercase;
  overflow-wrap: anywhere;
}
.instagram-feed__media {
  position: relative;
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
}
.instagram-feed__grid {
  display: grid;
  grid-template-columns: repeat(var(--instagram-posts-desktop), minmax(0, 1fr));
  gap: var(--instagram-gap);
}
.instagram-feed__item {
  position: relative;
  display: block;
  overflow: hidden;
  aspect-ratio: 1;
  border-radius: var(--instagram-card-radius);
  background: #fff4f4;
  color: inherit;
}
.instagram-feed--aspect-portrait .instagram-feed__item {
  aspect-ratio: 4 / 5;
}
.instagram-feed--aspect-landscape .instagram-feed__item {
  aspect-ratio: 4 / 3;
}
.instagram-feed__item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.4s ease;
}
.instagram-feed__item:hover img {
  transform: scale(1.04);
}
.instagram-feed__overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.3s ease;
}
.instagram-feed__item:hover .instagram-feed__overlay {
  background: rgba(0, 0, 0, 0.45);
}
.instagram-feed__overlay-icon {
  opacity: 0;
  transform: scale(0.8);
  transition: all 0.3s ease;
  color: #fff;
  font-size: 28px;
}
.instagram-feed__item:hover .instagram-feed__overlay-icon {
  opacity: 1;
  transform: scale(1);
}
.instagram-feed__video-badge {
  position: absolute;
  top: 8px;
  right: 8px;
  background: rgba(0,0,0,0.62);
  color: #fff;
  font-size: 10px;
  font-weight: 700;
  padding: 3px 7px;
  border-radius: 3px;
  text-transform: uppercase;
  letter-spacing: .08em;
}
.instagram-feed__footer {
  margin-top: 28px;
  text-align: var(--instagram-text-align-desktop);
}
.instagram-feed--layout-grid .instagram-feed__footer {
  text-align: var(--instagram-text-align-desktop);
}
.instagram-feed__follow {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42px;
  border: 1px solid currentColor;
  color: var(--instagram-text);
  background: transparent;
  font-size: var(--instagram-cta-size);
  font-weight: var(--instagram-cta-weight);
  letter-spacing: var(--instagram-cta-letter-spacing);
  line-height: 1.2;
  text-transform: var(--instagram-cta-text-transform);
  padding: 12px 24px;
  text-decoration: none;
  transition: background 0.2s, border-color 0.2s, color 0.2s;
}
.instagram-feed__follow:hover {
  border-color: var(--instagram-text);
  background: var(--instagram-text);
  color: var(--instagram-bg);
}
.instagram-feed__loading {
  grid-column: 1 / -1;
  text-align: center;
  padding: 40px;
  color: var(--instagram-accent);
  font-size: 13px;
  letter-spacing: .1em;
  text-transform: uppercase;
}
.instagram-feed__arrows {
  display: none;
  position: absolute;
  top: -54px;
  right: 0;
  gap: 8px;
  z-index: 2;
}
.instagram-feed__arrow {
  width: 38px;
  height: 38px;
  border: 1px solid currentColor;
  border-radius: 0;
  color: var(--instagram-text);
  background: transparent;
  cursor: pointer;
  transition: background .2s, color .2s;
}
.instagram-feed__arrow:hover {
  background: var(--instagram-text);
  color: var(--instagram-bg);
}
@media (min-width: 769px) {
  .instagram-feed--desktop-carousel .instagram-feed__arrows {
    display: flex;
  }
  .instagram-feed--desktop-carousel .instagram-feed__grid {
    display: flex;
    gap: var(--instagram-carousel-gap);
    overflow-x: auto;
    overflow-y: hidden;
    padding-inline: var(--instagram-carousel-peek);
    scroll-padding-inline: var(--instagram-carousel-peek);
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .instagram-feed--desktop-carousel .instagram-feed__grid::-webkit-scrollbar {
    display: none;
  }
  .instagram-feed--desktop-carousel.instagram-feed--snap .instagram-feed__grid {
    scroll-snap-type: x mandatory;
  }
  .instagram-feed--desktop-carousel .instagram-feed__item {
    flex: 0 0 calc((100% - (var(--instagram-carousel-gap) * (var(--instagram-posts-desktop) - 1))) / var(--instagram-posts-desktop));
  }
  .instagram-feed--desktop-carousel.instagram-feed--snap .instagram-feed__item {
    scroll-snap-align: start;
  }
}
@media (max-width: 1024px) and (min-width: 769px) {
  .instagram-feed > .container {
    padding-inline: var(--instagram-padding-x-tablet);
  }
  .instagram-feed__grid {
    grid-template-columns: repeat(var(--instagram-posts-tablet), minmax(0, 1fr));
  }
  .instagram-feed--desktop-carousel .instagram-feed__item {
    flex-basis: calc((100% - (var(--instagram-carousel-gap) * (var(--instagram-posts-tablet) - 1))) / var(--instagram-posts-tablet));
  }
}
@media (max-width: 768px) {
  .instagram-feed {
    padding: var(--instagram-section-padding-mobile) 0;
  }
  .instagram-feed > .container {
    padding-inline: var(--instagram-padding-x-mobile);
  }
  .instagram-feed__inner,
  .instagram-feed--layout-split .instagram-feed__inner {
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
  }
  .instagram-feed__intro,
  .instagram-feed--layout-grid .instagram-feed__intro {
    max-width: none;
    margin: 0;
    text-align: var(--instagram-text-align-mobile);
  }
  .instagram-feed__title {
    max-width: 100%;
    font-size: var(--instagram-title-size-mobile);
  }
  .instagram-feed__body {
    max-width: 100%;
  }
  .instagram-feed__intro {
    overflow: visible;
  }
  .instagram-feed__intro .instagram-feed__title,
  .instagram-feed__intro .instagram-feed__body {
    margin-inline: auto;
  }
  .instagram-feed__footer,
  .instagram-feed--layout-grid .instagram-feed__footer {
    text-align: var(--instagram-text-align-mobile);
  }
  .instagram-feed__grid {
    grid-template-columns: repeat(var(--instagram-posts-mobile), minmax(0, 1fr));
    gap: var(--instagram-gap);
  }
  .instagram-feed--mobile-carousel .instagram-feed__arrows {
    display: flex;
    top: -46px;
  }
  .instagram-feed--mobile-carousel .instagram-feed__grid {
    display: flex;
    gap: var(--instagram-carousel-gap);
    overflow-x: auto;
    overflow-y: hidden;
    padding-inline: var(--instagram-carousel-peek);
    margin-inline: calc(-1 * var(--instagram-carousel-peek));
    scroll-padding-inline: var(--instagram-carousel-peek);
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .instagram-feed--mobile-carousel .instagram-feed__grid::-webkit-scrollbar {
    display: none;
  }
  .instagram-feed--mobile-carousel.instagram-feed--snap .instagram-feed__grid {
    scroll-snap-type: x mandatory;
  }
  .instagram-feed--mobile-carousel .instagram-feed__item {
    flex: 0 0 calc((100% - (var(--instagram-carousel-gap) * (var(--instagram-posts-mobile) - 1))) / var(--instagram-posts-mobile));
  }
  .instagram-feed--mobile-carousel.instagram-feed--snap .instagram-feed__item {
    scroll-snap-align: start;
  }
}
@media (max-width: 480px) {
  .instagram-feed__follow {
    width: 100%;
  }
}
</style>

<script>
(function() {
  const proxyUrl = 'https://black-darkness-b2ec.danlyons20.workers.dev';
  const token = '{{ section.settings.access_token }}';
  const igId = '{{ section.settings.ig_account_id }}';
  const count = {{ section.settings.post_count }};
  const grid = document.getElementById('instagram-grid');

  if (!token || !igId) {
    grid.innerHTML = '<div class="instagram-feed__loading">Add your Instagram token in section settings.</div>';
    return;
  }

  fetch(`${proxyUrl}/?token=${encodeURIComponent(token)}&ig_id=${igId}&count=${count}`)
    .then(r => r.json())
    .then(data => {
      if (!data.data || data.error) {
        grid.innerHTML = '<div class="instagram-feed__loading">Could not load feed.</div>';
        return;
      }
      grid.innerHTML = data.data.map(post => {
        const rawImg = post.media_type === 'VIDEO' ? post.thumbnail_url : post.media_url;
        const img = `${proxyUrl}/image?url=${encodeURIComponent(rawImg)}`;
        const isVideo = post.media_type === 'VIDEO';
        const isCarousel = post.media_type === 'CAROUSEL_ALBUM';
        return `
          <a href="${post.permalink}" target="_blank" class="instagram-feed__item">
            <img src="${img}" alt="Instagram" loading="lazy">
            <div class="instagram-feed__overlay">
              <svg class="instagram-feed__overlay-icon" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
            </div>
            ${isVideo ? '<span class="instagram-feed__video-badge">Reel</span>' : ''}
            ${isCarousel ? '<span class="instagram-feed__video-badge">Album</span>' : ''}
          </a>
        `;
      }).join('');
    })
    .catch(() => {
      grid.innerHTML = '<div class="instagram-feed__loading">Could not load feed.</div>';
    });
})();

(function() {
  const section = document.querySelector('.instagram-feed--{{ section.id }}');
  if (!section) return;

  const grid = section.querySelector('#instagram-grid');
  const controls = section.querySelectorAll('[data-instagram-arrow]');
  if (!grid || !controls.length) return;

  controls.forEach((control) => {
    control.addEventListener('click', () => {
      const direction = control.getAttribute('data-instagram-arrow') === 'prev' ? -1 : 1;
      const distance = Math.max(grid.clientWidth * 0.8, 240);
      grid.scrollBy({ left: direction * distance, behavior: 'smooth' });
    });
  });
})();
</script>

{% schema %}
{
  "name": "Instagram Feed",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Follow our journey"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Tag us @yaomriswimwear"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body text",
      "default": "<p>Fresh drops, campaign moments and real swimwear inspiration from the Ya Omri world.</p>"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Instagram handle (without @)",
      "default": "yaomriswimwear"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label"
    },
    {
      "type": "checkbox",
      "id": "show_follow",
      "label": "Show follow button",
      "default": true
    },
    {
      "type": "header",
      "content": "Instagram feed"
    },
    {
      "type": "textarea",
      "id": "access_token",
      "label": "Instagram access token"
    },
    {
      "type": "text",
      "id": "ig_account_id",
      "label": "Instagram Business Account ID",
      "default": "17841403550958066"
    },
    {
      "type": "range",
      "id": "post_count",
      "label": "Number of posts",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "default": "split",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "split",
          "label": "Split"
        }
      ]
    },
    {
      "type": "select",
      "id": "desktop_display_mode",
      "label": "Desktop display mode",
      "default": "grid",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "carousel",
          "label": "Carousel"
        }
      ]
    },
    {
      "type": "select",
      "id": "mobile_display_mode",
      "label": "Mobile display mode",
      "default": "carousel",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "carousel",
          "label": "Carousel"
        }
      ]
    },
    {
      "type": "range",
      "id": "intro_width",
      "label": "Intro width",
      "min": 25,
      "max": 45,
      "step": 1,
      "unit": "%",
      "default": 34
    },
    {
      "type": "range",
      "id": "split_column_gap",
      "label": "Split column gap",
      "min": 16,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "select",
      "id": "text_align_desktop",
      "label": "Text alignment desktop",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_align_mobile",
      "label": "Text alignment mobile",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "range",
      "id": "section_padding_desktop",
      "label": "Section padding desktop",
      "min": 32,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 72
