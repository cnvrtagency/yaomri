{%- liquid
   assign limit = 5
   assign show_pr = false
   assign img_size = 80
   assign only_icon = 't4s-only_icon_' | append: settings.only_icon
   assign sid = section.id
   if sid == 'mb_cat'
    assign show_code = true
   elsif sid != 'mb_cat' and request.design_mode or request.page_type == 'index' 
    assign show_code = true
   else
    assign show_code = false
   endif -%}
   
{%- if show_code -%}
   {%- capture yo_mobile_drawer_content -%}
   <ul id="menu-mb__cat" class="t4s-mb__menu" data-section-id="{{ sid }}">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}

            {%- liquid 
               assign block_stts  = block.settings
               assign collection  = collections[block_stts.cat]
               assign tt_current  = block_stts.title | default: collection.title
               assign url_current = block_stts.url | default: collection.url
               if tt_current == blank
                  continue
               endif
           -%}
              {%- case block.type -%}
                {%- when 'cat' -%}
                    {%- if linklists[block_stts.menu].links.size > 0 -%}
                        <li id="item_{{ block.id }}" class="t4s-menu-item t4s-item-level-0 t4s-menu-item-has-children {{ only_icon }}" {{ block.shopify_attributes }}>
                          <a href="{{ url_current }}"><span class="t4s-nav_link_txt t4s-d-flex t4s-align-items-center">
  
                           {%- if block_stts.icons_op == '2' and block_stts.icon != blank %}<i class="{{ block_stts.icon | strip }}"></i>
                           {%- elsif block_stts.icons_op == '1' and block_stts.image != blank %}
                               {%- assign image = block_stts.image -%}
                              <i class="t4s-d-inline-block t4s-pr">
                                 <img class="t4s-img_catk_mb lazyloadt4s" src="{% render 'img_svg', w: image.width, h: image.height %}" width="{{ image.width }}" height="{{ image.height }}" data-src="{{ image | image_url: width: img_size }}" alt="{{ image.alt | escape }}">
                                 <span class="lazyloadt4s-loader is-bg-img" style="background: url({{ image | image_url: width: 1 }});"></span>
                               </i>
                            {% endif -%}
  
                           {{ tt_current }}{% if block_stts.lb != blank %}<span class="t4s-lb_nav_mb" style="background-color: {{ block_stts.lb_cl }}">{{ block_stts.lb }}</span>{% endif %}</span><span class="t4s-mb-nav__icon"></span></a>
                             <ul class="t4s-sub-menu">
                                {%- for link in linklists[block_stts.menu].links -%}
  
                                   {%- assign arrlt = link.title | split: '[' -%}
                                   {%- if link.links != blank -%}
                                      <li class="t4s-menu-item t4s-item-level-1 t4s-menu-item-has-children {{ only_icon }}{% if link.active %} is--current{% endif %}">
                                         <a href="{{ link.url }}"><span class="t4s-nav_link_txt t4s-d-flex t4s-align-items-center">{%- render 'lb_inc_mb', arrlt: arrlt -%}</span><span class="t4s-mb-nav__icon"></span></a>
                                         <ul class="t4s-sub-sub-menu">
                                            {%- for child_link in link.links -%}
  
                                               {%- assign arrlt = child_link.title | split: '[' -%}
                                               {%- if child_link.links != blank -%}
                                                  <li id="item_{{ block.id }}" class="t4s-menu-item t4s-item-level-2 t4s-menu-item-has-children {{ only_icon }}{% if child_link.active %} is--current{% endif %}">
                                                     <a href="{{ child_link.url }}"><span class="t4s-nav_link_txt t4s-d-flex t4s-align-items-center">{%- render 'lb_inc_mb', arrlt: arrlt -%}</span><span class="t4s-mb-nav__icon"></span></a>
                                                     <ul class="t4s-sub-sub-sub-menu">
  
                                                        {%- for grandchild_link in child_link.links -%}
                                                        {%- assign arrlt = grandchild_link.title | split: '[' -%}
                                                        <li class="t4s-menu-item t4s-item-level-3{% if grandchild_link.active %} is--current{% endif %}"><a href="{{ grandchild_link.url }}">{%- render 'lb_inc_mb', arrlt: arrlt -%}</a></li>
                                                        {%- endfor -%}
  
                                                     </ul>
                                                  </li>
                                               {%- else -%}
                                                   <li class="t4s-menu-item t4s-item-level-2{% if child_link.active %} is--current{% endif %}"><a href="{{ child_link.url }}">{%- render 'lb_inc_mb', arrlt: arrlt -%}</a></li>
                                               {%- endif -%}
  
                                            {%- endfor -%}
                                         </ul>
                                      </li>
                                   {%- else -%}
                                      <li class="t4s-menu-item t4s-item-level-1{% if link.active %} is--current{% endif %}"><a href="{{ link.url }}">{%- render 'lb_inc_mb', arrlt: arrlt -%}</a></li>
                                   {%- endif -%}
  
                                {%- endfor -%}
                             </ul>
                       </li>
                    {%- else -%}
                        <li id="item_{{ block.id }}" class="t4s-menu-item t4s-item-level-0"><a href="{{ url_current }}">
  
                         {%- if block_stts.icons_op == '2' and block_stts.icon != blank %}<i class="{{ block_stts.icon | strip }}"></i>
                         {%- elsif block_stts.icons_op == '1' and block_stts.image != blank %}
                            {%- assign image = block_stts.image -%}
                            <i class="t4s-d-inline-block t4s-pr">
                                <img class="t4s-img_catk_mb lazyloadt4s" src="{% render 'img_svg', w: image.width, h: image.height %}" width="{{ image.width }}" height="{{ image.height }}" data-src="{{ image | image_url: width: img_size }}" alt="{{ image.alt | escape }}">
                                <span class="lazyloadt4s-loader is-bg-img" style="background: url({{ image | image_url: width: 1 }});"></span>
                            </i>
                        {% endif -%}
  
                         {{ tt_current }}{% if block_stts.lb != blank %}<span class="t4s-lb_nav_mb" style="background-color: {{ block_stts.lb_cl }}">{{ block_stts.lb }}</span>{% endif %}</a></li>
                    {%- endif -%}
  
                {%- else -%}
              
                 {%- capture get_sub_cat -%}
                        {%- for i in (1..25) -%}
                        {%- assign cat = 'cat' | append: i -%}
                        {%- assign url = 'url' | append: i -%}
                        {%- assign image = 'image' | append: i -%}
                        {%- assign cat_id = block_stts[cat] -%}
                        {%- assign url_id = block_stts[url] -%}
                        {%- assign image_id = block_stts[image] -%}
                        {%- assign collec = collections[cat_id] -%}
  
                            {%- if collec == blank and url_id == blank %}{% continue %}{% endif %}{% assign image = image_id | default: collec.image -%}
                             <div class="t4s-cat_grid_item t4s-cat_space_item">
                              <div class="t4s-cat_grid_item__content t4s-pr t4s-oh">
                                 <a href="{{ url_id | default: collec.url }}" class="t4s-d-block t4s_ratio t4s-cat_grid_item__link" style="--aspect-ratioapt: {{ image.aspect_ratio | default: 1.7777 }}">
                                  {%- if image != blank -%}
                                      <img class="lazyloadt4s" data-src="{{ image | image_url: width: 1 }}" data-widths="[100,200,400,600,700,800,900,1000,1200,1400,1600]" data-optimumx="2" data-sizes="auto" src="{% render 'img_svg', w: image.width, h: image.height %}" width="{{ image.width }}" height="{{ image.height }}" alt="{{ image.alt | escape }}">    
                                      <span class="lazyloadt4s-loader is-bg-img" style="background: url({{ image | image_url: width: 1 }});"></span>
                                  {%- else -%}
                                     {{ 'image' | placeholder_svg_tag: 't4s-placeholder-svg t4s-obj-eff' }}
                                  {%- endif -%}
                                 </a>
                                 <div class="t4s-cat_grid_item__wrapper t4s-pe-none"><div class="t4s-cat_grid_item__title h3">{{ collec.title }}</div></div>
                              </div>
                             </div>
                           
                        {%- endfor -%}
                 {%- endcapture -%}
  
                 {%- if get_sub_cat != blank -%}
                     <li id="item_{{ block.id }}" class="t4s-menu-item t4s-menu-item-cat t4s-item-level-0 t4s-menu-item-has-children {{ only_icon }}" {{ block.shopify_attributes }}>
                       <a href="{{ url_current }}"><span class="t4s-nav_link_txt t4s-d-flex t4s-align-items-center">
  
                        {%- if block_stts.icons_op == '2' and block_stts.icon != blank %}<i class="{{ block_stts.icon | strip }}"></i>
                        {%- elsif block_stts.icons_op == '1' and block_stts.image != blank %}
                               {%- assign image = block_stts.image -%}
                              <i class="t4s-d-inline-block t4s-pr">
                                 <img class="t4s-img_catk_mb lazyloadt4s" src="{% render 'img_svg', w: image.width, h: image.height %}" width="{{ image.width }}" height="{{ image.height }}" data-src="{{ image | image_url: width: img_size }}" alt="{{ image.alt | escape }}">
                                 <span class="lazyloadt4s-loader is-bg-img" style="background: url({{ image | image_url: width: 1 }});"></span>
                               </i>
                        {% endif -%}
  
                        {{ tt_current }}{% if block_stts.lb != blank %}<span class="t4s-lb_nav_mb" style="background-color: {{ block_stts.lb_cl }}">{{ block_stts.lb }}</span>{% endif %}</span><span class="t4s-mb-nav__icon"></span></a>
                        <ul class="t4s-sub-menu t4s_ratioadapt t4s_position_8 t4s_cover t4s-cat_design_2">{{ get_sub_cat }}</ul>
                    </li>
                 {%- else -%}
                     <li id="item_{{ block.id }}" class="t4s-menu-item t4s-item-level-0"><a href="{{ url_current }}">
  
                      {%- if block_stts.icons_op == '2' and block_stts.icon != blank %}<i class="{{ block_stts.icon | strip }}"></i>
                      {%- elsif block_stts.icons_op == '1' and block_stts.image != blank %}
                        {%- assign image = block_stts.image -%}
                            <i class="t4s-d-inline-block t4s-pr">
                                <img class="t4s-img_catk_mb lazyloadt4s" src="{% render 'img_svg', w: image.width, h: image.height %}" width="{{ image.width }}" height="{{ image.height }}" data-src="{{ image | image_url: width: img_size }}" alt="{{ image.alt | escape }}">
                                <span class="lazyloadt4s-loader is-bg-img" style="background: url({{ image | image_url: width: 1 }});"></span>
                            </i>
                        {% endif -%}
  
                      {{ tt_current }}{% if block_stts.lb != blank %}<span class="t4s-lb_nav_mb" style="background-color: {{ block_stts.lb_cl }}">{{ block_stts.lb }}</span>{% endif %}</a></li>
                 {%- endif -%}
              {%- endcase -%}
        {%- endfor -%}
     {%- else -%}
     <li><a href="/admin/themes/" style="font-size:10px;">Create your mobile categories menu sidebar and config from Section > Mobile Categories</a></li>
     {%- endif -%}
   </ul>
   {%- endcapture -%}
   {%- if section.settings.yaomri_mobile_drawer_enable -%}
     {%- liquid
       assign emit_root_styles = false
       if settings.mobile_nav_type == '2'
         assign emit_root_styles = true
       endif
     -%}
     {%- render 'yaomri-mobile-drawer', section: section, title: 'Categories', content: yo_mobile_drawer_content, emit_root_styles: emit_root_styles -%}
   {%- else -%}
     {{ yo_mobile_drawer_content }}
   {%- endif -%}
{%- else -%}
<div data-section-id="{{ sid }}"></div>
{%- endif -%}
  
  {% schema %}
    {
      "name": "Mobile Categories",
      "class": "t4s-sp-section-mb-cat",
      "max_blocks": 30,
      "settings": [
        {
          "type": "header",
          "content": "Ya Omri mobile drawer"
        },
        {
          "type": "checkbox",
          "id": "yaomri_mobile_drawer_enable",
          "label": "Enable Ya Omri mobile drawer",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "yaomri_mobile_drawer_search_enable",
          "label": "Show drawer search",
          "default": true
        },
        {
          "type": "color",
          "id": "yaomri_mobile_drawer_bg_color",
          "label": "Drawer background colour",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "yaomri_mobile_drawer_text_color",
          "label": "Text colour",
          "default": "#111111"
        },
        {
          "type": "color",
          "id": "yaomri_mobile_drawer_accent_color",
          "label": "Accent colour",
          "default": "#b88f92"
        },
        {
          "type": "color",
          "id": "yaomri_mobile_drawer_border_color",
          "label": "Divider colour",
          "default": "#e8e1da"
        },
        {
          "type": "select",
          "id": "yaomri_mobile_drawer_font_family",
          "label": "Font family",
          "default": "inherit",
          "options": [
            { "value": "inherit", "label": "Theme default" },
            { "value": "Arial", "label": "Arial" },
            { "value": "Helvetica", "label": "Helvetica" },
            { "value": "Georgia", "label": "Georgia" },
            { "value": "Times New Roman", "label": "Times New Roman" },
            { "value": "Montserrat", "label": "Montserrat" },
            { "value": "Poppins", "label": "Poppins" },
            { "value": "Inter", "label": "Inter" }
          ]
        },
        {
          "type": "range",
          "id": "yaomri_mobile_drawer_top_item_font_size",
          "label": "Top-level font size",
          "min": 12,
          "max": 24,
          "step": 1,
          "default": 15
        },
        {
          "type": "select",
          "id": "yaomri_mobile_drawer_top_item_weight",
          "label": "Top-level font weight",
          "default": "700",
          "options": [
            { "value": "400", "label": "400" },
            { "value": "500", "label": "500" },
            { "value": "600", "label": "600" },
            { "value": "700", "label": "700" },
            { "value": "800", "label": "800" },
            { "value": "900", "label": "900" }
          ]
        },
        {
          "type": "range",
          "id": "yaomri_mobile_drawer_sub_item_font_size",
          "label": "Submenu font size",
          "min": 11,
          "max": 20,
          "step": 1,
          "default": 13
        },
        {
          "type": "select",
          "id": "yaomri_mobile_drawer_sub_item_weight",
          "label": "Submenu font weight",
          "default": "500",
          "options": [
            { "value": "400", "label": "400" },
            { "value": "500", "label": "500" },
            { "value": "600", "label": "600" },
            { "value": "700", "label": "700" }
          ]
        },
        {
          "type": "checkbox",
          "id": "yaomri_mobile_drawer_item_italic",
          "label": "Italic menu items",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "yaomri_mobile_drawer_sub_item_italic",
          "label": "Italic submenu items",
          "default": false
        },
        {
          "type": "range",
          "id": "yaomri_mobile_drawer_heading_letter_spacing",
          "label": "Menu item letter spacing",
          "min": 0,
          "max": 3,
          "step": 0.1,
          "default": 0.4
        },
        {
          "type": "range",
          "id": "yaomri_mobile_drawer_item_spacing",
          "label": "Item spacing",
          "min": 10,
          "max": 22,
          "step": 1,
          "default": 12
        },
        {
          "type": "range",
          "id": "yaomri_mobile_drawer_submenu_indent",
          "label": "Submenu indent",
          "min": 12,
          "max": 36,
          "step": 1,
          "default": 18
        },
        {
          "type": "checkbox",
          "id": "yaomri_mobile_drawer_uppercase",
          "label": "Uppercase top-level items",
          "default": true
        },
        {
          "type": "color",
          "id": "yaomri_mobile_drawer_close_bg_color",
          "label": "Close button background",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "yaomri_mobile_drawer_close_icon_color",
          "label": "Close button icon colour",
          "default": "#111111"
        },
        {
          "type": "range",
          "id": "yaomri_mobile_drawer_close_icon_size",
          "label": "Close icon size",
          "min": 16,
          "max": 36,
          "step": 1,
          "unit": "px",
          "default": 24
        },
        {
          "type": "header",
          "content": "Bottom action panel"
        },
        {
          "type": "checkbox",
          "id": "yaomri_mobile_drawer_actions_enable",
          "label": "Show bottom action panel",
          "default": true
        },
        {
          "type": "color",
          "id": "yaomri_mobile_drawer_actions_bg_color",
          "label": "Action panel background",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "yaomri_mobile_drawer_actions_text_color",
          "label": "Action panel text colour",
          "default": "#111111"
        },
        {
          "type": "color",
          "id": "yaomri_mobile_drawer_actions_icon_color",
          "label": "Action panel icon colour",
          "default": "#111111"
        },
        {
          "type": "color",
          "id": "yaomri_mobile_drawer_actions_border_color",
          "label": "Action panel border colour",
          "default": "#e8e1da"
        },
        {
          "type": "color",
          "id": "yaomri_mobile_drawer_actions_button_bg",
          "label": "Action button background",
          "default": "#f8f6f3"
        },
        {
          "type": "color",
          "id": "yaomri_mobile_drawer_actions_button_text",
          "label": "Action button text colour",
          "default": "#111111"
        },
        {
          "type": "range",
          "id": "yaomri_mobile_drawer_actions_button_radius",
          "label": "Action button radius",
          "min": 0,
          "max": 24,
          "step": 1,
          "unit": "px",
          "default": 8
        },
        {
          "type": "range",
          "id": "yaomri_mobile_drawer_actions_icon_size",
          "label": "Action icon size",
          "min": 14,
          "max": 32,
          "step": 1,
          "unit": "px",
          "default": 18
        },
        {
          "type": "range",
          "id": "yaomri_mobile_drawer_actions_text_size",
          "label": "Action text size",
          "min": 10,
          "max": 18,
          "step": 1,
          "unit": "px",
          "default": 13
        },
        {
          "type": "select",
          "id": "yaomri_mobile_drawer_actions_text_weight",
          "label": "Action text weight",
          "options": [
            { "value": "400", "label": "400" },
            { "value": "500", "label": "500" },
            { "value": "600", "label": "600" },
            { "value": "700", "label": "700" },
            { "value": "800", "label": "800" }
          ],
          "default": "500"
        },
        {
          "type": "range",
          "id": "yaomri_mobile_drawer_actions_gap_top",
          "label": "Space above action panel",
          "min": 0,
          "max": 40,
          "step": 1,
          "unit": "px",
          "default": 8
        },
        {
          "type": "range",
          "id": "yaomri_mobile_drawer_width",
          "label": "Drawer width",
          "min": 300,
          "max": 480,
          "step": 5,
          "default": 400
        },
        {
          "type": "range",
          "id": "yaomri_mobile_drawer_radius",
          "label": "Drawer radius",
          "min": 0,
          "max": 28,
          "step": 1,
          "default": 8
        },
        {
          "type": "header",
          "content": "Image cards"
        },
        {
          "type": "checkbox",
          "id": "yaomri_mobile_drawer_cards_enable",
          "label": "Enable image cards",
          "default": true
        },
        {
          "type": "image_picker",
          "id": "yaomri_mobile_drawer_card_1_image",
          "label": "Card 1 image"
        },
        {
          "type": "text",
          "id": "yaomri_mobile_drawer_card_1_heading",
          "label": "Card 1 heading",
          "default": "Swimwear"
        },
        {
          "type": "text",
          "id": "yaomri_mobile_drawer_card_1_subtitle",
          "label": "Card 1 subtitle",
          "default": "Explore collection"
        },
        {
          "type": "url",
          "id": "yaomri_mobile_drawer_card_1_link",
          "label": "Card 1 link"
        },
        {
          "type": "image_picker",
          "id": "yaomri_mobile_drawer_card_2_image",
          "label": "Card 2 image"
        },
        {
          "type": "text",
          "id": "yaomri_mobile_drawer_card_2_heading",
          "label": "Card 2 heading",
          "default": "Resortwear"
        },
        {
          "type": "text",
          "id": "yaomri_mobile_drawer_card_2_subtitle",
          "label": "Card 2 subtitle",
          "default": "Explore collection"
        },
        {
          "type": "url",
          "id": "yaomri_mobile_drawer_card_2_link",
          "label": "Card 2 link"
        },
        {
          "type": "range",
          "id": "yaomri_mobile_drawer_card_radius",
          "label": "Image card radius",
          "min": 0,
          "max": 24,
          "step": 1,
          "default": 6
        },
        {
          "type": "range",
          "id": "yaomri_mobile_drawer_card_height",
          "label": "Image card height",
          "min": 96,
          "max": 220,
          "step": 4,
          "default": 120
        },
        {
          "type": "range",
          "id": "yaomri_mobile_drawer_card_heading_font_size",
          "label": "Card heading font size",
          "min": 18,
          "max": 40,
          "step": 1,
          "default": 24
        },
        {
          "type": "range",
          "id": "yaomri_mobile_drawer_card_subtitle_font_size",
          "label": "Card subtitle font size",
          "min": 10,
          "max": 18,
          "step": 1,
          "default": 11
        },
        {
          "type": "select",
          "id": "yaomri_mobile_drawer_card_subtitle_weight",
          "label": "Card subtitle font weight",
          "default": "500",
          "options": [
            { "value": "400", "label": "400" },
            { "value": "500", "label": "500" },
            { "value": "600", "label": "600" },
            { "value": "700", "label": "700" },
            { "value": "800", "label": "800" }
          ]
        },
        {
          "type": "range",
          "id": "yaomri_mobile_drawer_card_subtitle_letter_spacing",
          "label": "Card subtitle letter spacing",
          "min": 0,
          "max": 4,
          "step": 0.1,
          "default": 1.5
        },
        {
          "type": "select",
          "id": "yaomri_mobile_drawer_card_text_weight",
          "label": "Card text weight",
          "default": "500",
          "options": [
            { "value": "400", "label": "400" },
            { "value": "500", "label": "500" },
            { "value": "600", "label": "600" },
            { "value": "700", "label": "700" }
          ]
        },
        {
          "type": "checkbox",
          "id": "yaomri_mobile_drawer_card_heading_uppercase",
          "label": "Uppercase card headings",
          "default": false
        },
