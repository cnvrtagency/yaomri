{% style %}
  {% liquid
    assign glass_background_alpha = section.settings.glass_background_opacity | divided_by: 100.0
    assign glass_border_alpha = section.settings.glass_border_opacity | divided_by: 100.0
  %}

  #shopify-section-{{ section.id }} .custom-scroll-bar {
    --scroll-bg-color: {{ section.settings.bg_color }};
    --scroll-surface-color: {% if section.settings.enable_glass_effect %}{{ section.settings.bg_color | color_modify: 'alpha', glass_background_alpha }}{% else %}{{ section.settings.bg_color }}{% endif %};
    --scroll-text-color: {{ section.settings.text_color }};
    --scroll-border-color: {% if section.settings.enable_glass_effect %}{{ section.settings.border_color | color_modify: 'alpha', glass_border_alpha }}{% else %}{{ section.settings.border_color }}{% endif %};
    --scroll-edge-fade-width: {{ section.settings.edge_fade_width }}px;
    --scroll-glass-blur: {{ section.settings.glass_blur }}px;
    --scroll-glass-saturation: {{ section.settings.glass_saturation }}%;
    background: var(--scroll-surface-color);
    color: {{ section.settings.text_color }};
    overflow: hidden;
    position: relative;
    display: flex;
    align-items: center;
    min-height: {{ section.settings.min_height_desktop }}px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    border-top: {{ section.settings.border_top_width }}px solid var(--scroll-border-color);
    border-bottom: {{ section.settings.border_bottom_width }}px solid var(--scroll-border-color);
    {% if section.settings.enable_glass_effect %}
      backdrop-filter: blur(var(--scroll-glass-blur)) saturate(var(--scroll-glass-saturation));
      -webkit-backdrop-filter: blur(var(--scroll-glass-blur)) saturate(var(--scroll-glass-saturation));
    {% endif %}
  }

  #shopify-section-{{ section.id }} .custom-scroll-track {
    display: flex;
    width: max-content;
    animation: customScroll-{{ section.id }} calc({{ section.settings.speed }}s / max(var(--motion-speed-multiplier, 1), .01)) linear infinite;
    animation-direction: {% if section.settings.direction == 'right' %}reverse{% else %}normal{% endif %};
  }

  #shopify-section-{{ section.id }} .custom-scroll-group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .custom-scroll-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 0 {{ section.settings.item_gap }}px;
    white-space: nowrap;
    font-size: {{ section.settings.desktop_font_size }}px;
    line-height: 1.1;
    color: {{ section.settings.text_color }};
    text-transform: {% if section.settings.uppercase %}uppercase{% else %}none{% endif %};
    letter-spacing: {{ section.settings.letter_spacing }}px;
  }

  #shopify-section-{{ section.id }} .custom-scroll-item-text {
    font-family: var(--item-font-family);
    font-weight: var(--item-font-weight);
    font-style: var(--item-font-style);
  }

  #shopify-section-{{ section.id }} .custom-scroll-item-link {
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .custom-scroll-item-link:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: 4px;
  }

  #shopify-section-{{ section.id }} .custom-scroll-highlight {
    display: inline-flex;
    align-items: center;
    padding: var(--scroll-highlight-padding-y) var(--scroll-highlight-padding-x);
    border: var(--scroll-highlight-border-width) solid var(--scroll-highlight-border);
    border-radius: var(--scroll-highlight-radius);
    line-height: 1;
    vertical-align: baseline;
  }

  #shopify-section-{{ section.id }} .custom-scroll-highlight--background {
    color: var(--scroll-highlight-text);
    background: var(--scroll-highlight-bg);
  }

  #shopify-section-{{ section.id }} .custom-scroll-highlight--text_colour {
    color: var(--scroll-highlight-text);
    background: transparent;
  }

  #shopify-section-{{ section.id }} .custom-scroll-highlight--outline {
    color: var(--scroll-highlight-text);
    background: transparent;
  }

  #shopify-section-{{ section.id }} .custom-scroll-separator {
    display: {% if section.settings.show_separator %}inline-flex{% else %}none{% endif %};
    width: {{ section.settings.separator_size }}px;
    height: {{ section.settings.separator_size }}px;
    border-radius: 999px;
    background: {{ section.settings.separator_color }};
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .custom-scroll-bar:hover .custom-scroll-track {
    {% if section.settings.pause_on_hover %}
      animation-play-state: paused;
    {% endif %}
  }

  #shopify-section-{{ section.id }} .custom-scroll-bar:focus-within .custom-scroll-track {
    {% if section.settings.pause_on_hover %}
      animation-play-state: paused;
    {% endif %}
  }

  #shopify-section-{{ section.id }} .custom-scroll-bar::before,
  #shopify-section-{{ section.id }} .custom-scroll-bar::after {
    {% if section.settings.enable_edge_fade %}
      content: "";
      position: absolute;
      top: 0;
      bottom: 0;
      z-index: 2;
      width: var(--scroll-edge-fade-width);
      pointer-events: none;
    {% else %}
      content: none;
    {% endif %}
  }

  #shopify-section-{{ section.id }} .custom-scroll-bar::before {
    left: 0;
    background: linear-gradient(to right, var(--scroll-surface-color), transparent);
  }

  #shopify-section-{{ section.id }} .custom-scroll-bar::after {
    right: 0;
    background: linear-gradient(to left, var(--scroll-surface-color), transparent);
  }

  @keyframes customScroll-{{ section.id }} {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-12.5%);
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .custom-scroll-track {
      animation-duration: calc({{ section.settings.mobile_speed }}s / max(var(--motion-speed-multiplier, 1), .01));
    }

    #shopify-section-{{ section.id }} .custom-scroll-item {
      font-size: {{ section.settings.mobile_font_size }}px;
      padding: 0 {{ section.settings.mobile_item_gap }}px;
    }

    #shopify-section-{{ section.id }} .custom-scroll-bar {
      min-height: {{ section.settings.min_height_mobile }}px;
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .custom-scroll-track {
      animation: none;
      flex-wrap: wrap;
      width: auto;
    }

    #shopify-section-{{ section.id }} .custom-scroll-group[aria-hidden="true"] {
      display: none;
    }
  }
{% endstyle %}

<div class="custom-scroll-bar"{% if settings.enable_animations and settings.animations_reveal_on_scroll and settings.reduce_motion_mode == 'respect_system' %} timeline hdt-reveal="slide-in"{% endif %}>
  <div class="custom-scroll-track">
    {% for group_index in (1..8) %}
      {% assign is_clone_group = false %}
      {% if group_index > 1 %}
        {% assign is_clone_group = true %}
      {% endif %}

      <div class="custom-scroll-group"{% if is_clone_group %} aria-hidden="true"{% endif %}>
        {% for block in section.blocks %}
          {% liquid
            assign item_font = section.settings.font_family
            assign item_weight = section.settings.font_weight
            assign item_style = 'normal'
            assign item_link = block.settings.link
            assign item_text = block.settings.text | default: ''
            assign highlight_text = block.settings.highlight_text | default: ''
            assign escaped_item_text = item_text | escape
            assign rendered_item_text = escaped_item_text

            if section.settings.italic
              assign item_style = 'italic'
            endif

            if block.settings.font_family != 'inherit'
              assign item_font = block.settings.font_family
            endif

            if block.settings.font_weight != 'inherit'
              assign item_weight = block.settings.font_weight
            endif

            if block.settings.italic_override == 'italic'
              assign item_style = 'italic'
            elsif block.settings.italic_override == 'normal'
              assign item_style = 'normal'
            endif

            if highlight_text != blank and item_text contains highlight_text
              assign escaped_highlight_text = highlight_text | escape
              capture highlight_markup
                echo '<span class="custom-scroll-highlight custom-scroll-highlight--'
                echo block.settings.highlight_style
                echo '">'
                echo escaped_highlight_text
                echo '</span>'
              endcapture
              assign rendered_item_text = escaped_item_text | replace_first: escaped_highlight_text, highlight_markup
            endif
          %}

          <div
            class="custom-scroll-item"
            style="
              --item-font-family: {{ item_font }};
              --item-font-weight: {{ item_weight }};
              --item-font-style: {{ item_style }};
              --scroll-highlight-text: {{ block.settings.highlight_text_color }};
              --scroll-highlight-bg: {{ block.settings.highlight_background_color }};
              --scroll-highlight-border: {{ block.settings.highlight_border_color }};
              --scroll-highlight-border-width: {{ block.settings.highlight_border_width }}px;
              --scroll-highlight-radius: {{ block.settings.highlight_radius }}px;
              --scroll-highlight-padding-x: {{ block.settings.highlight_padding_x }}px;
              --scroll-highlight-padding-y: {{ block.settings.highlight_padding_y }}px;
            "
            {% unless is_clone_group %}{{ block.shopify_attributes }}{% endunless %}
          >
            {% if item_link != blank %}
              <a
                class="custom-scroll-item-text custom-scroll-item-link"
                href="{{ item_link }}"
                {% if is_clone_group %}tabindex="-1"{% endif %}
                {% if block.settings.open_in_new_tab %}
                  target="_blank" rel="noopener noreferrer"
                {% endif %}
              >
                {{ rendered_item_text }}
              </a>
            {% else %}
              <span class="custom-scroll-item-text">{{ rendered_item_text }}</span>
            {% endif %}
            <span class="custom-scroll-separator"></span>
          </div>
        {% endfor %}
      </div>
    {% endfor %}
  </div>
</div>

