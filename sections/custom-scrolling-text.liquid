{% style %}
  #shopify-section-{{ section.id }} .custom-scroll-bar {
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    overflow: hidden;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .custom-scroll-track {
    display: flex;
    width: max-content;
    animation: customScroll-{{ section.id }} {{ section.settings.speed }}s linear infinite;
  }

  #shopify-section-{{ section.id }} .custom-scroll-group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .custom-scroll-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 0 {{ section.settings.item_gap }}px;
    white-space: nowrap;
    font-size: {{ section.settings.desktop_font_size }}px;
    line-height: 1.1;
    color: {{ section.settings.text_color }};
    text-transform: {% if section.settings.uppercase %}uppercase{% else %}none{% endif %};
    letter-spacing: {{ section.settings.letter_spacing }}px;
  }

  #shopify-section-{{ section.id }} .custom-scroll-item-text {
    font-family: var(--item-font-family);
    font-weight: var(--item-font-weight);
    font-style: var(--item-font-style);
  }

  #shopify-section-{{ section.id }} .custom-scroll-separator {
    display: {% if section.settings.show_separator %}inline-flex{% else %}none{% endif %};
    width: {{ section.settings.separator_size }}px;
    height: {{ section.settings.separator_size }}px;
    border-radius: 999px;
    background: {{ section.settings.separator_color }};
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .custom-scroll-bar:hover .custom-scroll-track {
    {% if section.settings.pause_on_hover %}
      animation-play-state: paused;
    {% endif %}
  }

  @keyframes customScroll-{{ section.id }} {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .custom-scroll-item {
      font-size: {{ section.settings.mobile_font_size }}px;
      padding: 0 {{ section.settings.mobile_item_gap }}px;
    }

    #shopify-section-{{ section.id }} .custom-scroll-bar {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
  }
{% endstyle %}

<div class="custom-scroll-bar">
  <div class="custom-scroll-track">
    <div class="custom-scroll-group">
      {% for block in section.blocks %}
        {% liquid
          assign item_font = section.settings.font_family
          assign item_weight = section.settings.font_weight
          assign item_style = 'normal'

          if section.settings.italic
            assign item_style = 'italic'
          endif

          if block.settings.font_family != 'inherit'
            assign item_font = block.settings.font_family
          endif

          if block.settings.font_weight != 'inherit'
            assign item_weight = block.settings.font_weight
          endif

          if block.settings.italic_override == 'italic'
            assign item_style = 'italic'
          elsif block.settings.italic_override == 'normal'
            assign item_style = 'normal'
          endif
        %}

        <div
          class="custom-scroll-item"
          style="
            --item-font-family: {{ item_font }};
            --item-font-weight: {{ item_weight }};
            --item-font-style: {{ item_style }};
          "
          {{ block.shopify_attributes }}
        >
          <span class="custom-scroll-item-text">{{ block.settings.text }}</span>
          <span class="custom-scroll-separator"></span>
        </div>
      {% endfor %}
    </div>

    <div class="custom-scroll-group" aria-hidden="true">
      {% for block in section.blocks %}
        {% liquid
          assign item_font = section.settings.font_family
          assign item_weight = section.settings.font_weight
          assign item_style = 'normal'

          if section.settings.italic
            assign item_style = 'italic'
          endif

          if block.settings.font_family != 'inherit'
            assign item_font = block.settings.font_family
          endif

          if block.settings.font_weight != 'inherit'
            assign item_weight = block.settings.font_weight
          endif

          if block.settings.italic_override == 'italic'
            assign item_style = 'italic'
          elsif block.settings.italic_override == 'normal'
            assign item_style = 'normal'
          endif
        %}

        <div
          class="custom-scroll-item"
          style="
            --item-font-family: {{ item_font }};
            --item-font-weight: {{ item_weight }};
            --item-font-style: {{ item_style }};
          "
        >
          <span class="custom-scroll-item-text">{{ block.settings.text }}</span>
          <span class="custom-scroll-separator"></span>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

